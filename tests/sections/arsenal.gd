extends RefCounted
const SECTION := "arsenal"
func run(t) -> void:
	var eco: Node = t.autoload("EconomyManager")
	eco.reset()
	t.check("weapon_category_routes_to_store",ItemKinds.storage_of("sword_rusty") == &"weapon" and eco.arsenal.count_total("sword_rusty") == 1 and not eco.get_inventory_dict().has(&"sword_rusty"))
	t.check("starter_equipped",eco.equipped_item(&"weapon") == &"sword_rusty")
	var slots: int = eco.used_slots()
	t.check("store_contract_answers",eco.add_item(&"iron_sword",2,true) and eco.used_slots() == slots and eco.count_item(&"iron_sword") == 2)
	t.check("same_family_higher_rating_equips",eco.equipped_item(&"weapon") == &"iron_sword" and eco.get_weapon_damage() == 12)
	eco.add_item(&"wpn_club_trunk",1,true)
	t.check("better_other_family_keeps_choice",eco.equipped_item(&"weapon") == &"iron_sword")
	t.check("equip_other_family_deliberately",eco.equip(&"weapon",&"wpn_club_trunk") and eco.equipped_item(&"weapon") == &"wpn_club_trunk")
	t.check("equipped_copy_not_sellable",eco.arsenal.count_stock("wpn_club_trunk") == 0 and not eco.remove_item(&"wpn_club_trunk"))
	eco.equip(&"weapon",&"iron_sword")
	t.check("only_spare_copy_can_leave",eco.arsenal.count_stock("iron_sword") == 1 and eco.remove_item(&"iron_sword") and not eco.remove_item(&"iron_sword"))
	t.check("sell_list_excludes_equipped_copy",eco.list_sellable().all(func(row): return str(row.id) != "iron_sword"))
	var wire: Dictionary = JSON.parse_string(JSON.stringify(eco.to_dict()))
	eco.reset()
	t.check("save_roundtrip",eco.from_dict(wire) and eco.arsenal.count_total("iron_sword") == 1 and eco.equipped_item(&"weapon") == &"iron_sword")
	t.check("roundtrip_ids_are_stringnames",eco.arsenal.owned_ids().all(func(id): return id is StringName))
	eco.from_dict({"v":1,"gold":30,"inventory":[{"id":"sword_rusty","amount":1},{"id":"iron_sword","amount":1}],"equipment":{"weapon":"sword_rusty"}})
	t.check("v1_save_adopts_backpack_weapons",eco.inventory.is_empty() and eco.count_item(&"iron_sword") == 1 and eco.arsenal.count_total("sword_rusty") == 1)
	t.check("v1_player_choice_survives",eco.equipped_item(&"weapon") == &"sword_rusty")
	var store := Arsenal.new()
	t.check("invalid_rows_dropped_and_counts_capped",store.from_dict({"unknown":3,"wood":3,"iron_sword":100,"sword_rusty":-1,"wpn_club_oak":2.5,"wpn_club_trunk":9}) and store.owned.size() == 2 and store.count_total("iron_sword") == 9 and store.count_total("wpn_club_trunk") == 1)
	t.check("copy_cap_all_or_nothing",not store.add("iron_sword",1) and store.count_total("iron_sword") == 9 and not store.add("sword_rusty",9223372036854775807))
	store.free()
	eco.reset()
