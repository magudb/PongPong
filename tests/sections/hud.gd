extends RefCounted
const SECTION := "hud"
const TIMEOUT_S := 120.0
func run(t) -> void:
	if OS.get_environment("TRAETOPPEN_BAKE_HUD") == "1":
		var built: Dictionary = t.run_godot_script("res://tools/ui/bake_hud.gd")
		t.check("scenes_compile", built.code == 0 and not built.output.contains("SCRIPT ERROR:") and not built.output.contains("ERROR:"), built.output)
		if built.code != 0 or built.output.contains("SCRIPT ERROR:"):
			return
	t.autoload("EventBus").new_game_started.connect(func(): t.autoload("GameManager").set_flag(GameManager.FLAG_INTRO_PENDING, false), CONNECT_ONE_SHOT)
	await t.start_world()
	var ui: GameUI = t.tree.get_first_node_in_group("game_ui")
	var hud: Control = ui.get_screen(&"hud")
	t.check("live_scene", hud != null)
	if hud == null:
		return
	await t.frames(2)
	t.check("banner_hidden_on_world_load", not hud.get_node("%AreaBanner").get_node("%Title").visible)
	t.check("eight_slots", hud.hotbar.get_child_count() == 8)
	t.check("player_initial_state", hud._entries == t.player().hotbar.entries())
	var bus: Node = t.autoload("EventBus")
	var gm: Node = t.autoload("GameManager")
	var lm: Node = t.autoload("LocalizationManager")
	var qm: Node = t.autoload("QuestManager")
	gm.push_modal(&"hud_test", false)
	# Frozen clock during checks. Values are the actual EventBus contract.
	bus.gold_changed.emit(1250, 0)
	bus.day_started.emit(16, &"foraar")
	bus.weather_changed.emit(&"klart")
	bus.time_of_day_changed.emit(24, 5)
	t.check("v2_date_block_text", hud.day_label.text == "Forår · Dag 16")
	t.check("clock_text_after_midnight", hud.time_label.text == "Tirsdag · 00:05 · Solskin", hud.time_label.text)
	bus.time_of_day_changed.emit(25, 59)
	t.check("clock_01_59_same_day", hud.time_label.text.contains("01:59") and hud.day_label.text == "Forår · Dag 16")
	var date_widths: Array[float] = []
	for weather in [&"klart",&"regn",&"taage",&"sne",&"torden"]:
		bus.weather_changed.emit(weather)
		await t.frames(2)
		date_widths.append(hud.get_node("%DatePanel").size.x)
	t.check("date_card_keeps_guide_width_in_short_weather",date_widths.all(func(width):return width>=252.0 and width<=253.0),"252px guide minimum, at most one pixel of font rounding: "+str(date_widths))
	bus.weather_changed.emit(&"klart")
	t.check("gold_number_only", hud.gold_label.text == "1.250")
	bus.player_stats_changed.emit({"stamina": 72, "max_stamina": 120, "half_hearts": 7, "max_half_hearts": 10})
	t.check("values_after_stats", hud.stamina_bar.value == 72 and hud.stamina_bar.max_value == 120 and hud.hearts.half_hearts == 7)
	t.check("v2_energy_in_chip", hud.get_node("%MoneyChip").is_ancestor_of(hud.stamina_bar) and hud.stamina_bar.size == Vector2(110, 14), str(hud.stamina_bar.size))
	t.check("hearts_row_always_visible", hud.hearts.visible)
	bus.home_upgrade_progress.emit(3, 5)
	t.check("construction_chip", hud.construction.visible and hud.get_node("%ConstructionText").text.contains("3"))
	t.check("construction_position", hud.construction.position == Vector2(40, 140))
	bus.home_upgrade_progress.emit(0, 5)
	t.check("construction_hidden_when_finished", not hud.construction.visible)
	var whisper: Node = hud.get_node("%WhisperLine")
	bus.whisper_requested.emit("WHISPER_TOO_EARLY")
	t.check("whisper_on_farm", whisper.is_showing() and whisper.shown_text() != "WHISPER_TOO_EARLY")
	bus.whisper_requested.emit("Lukket lige nu. Åbner kl. 07:00.")
	t.check("whisper_accepts_formatted_string", whisper.shown_text() == "Lukket lige nu. Åbner kl. 07:00.")
	var prompt: Node = hud.get_node("%PromptPill")
	bus.interaction_prompt_changed.emit("UI_SLEEP")
	t.check("prompt", prompt.shown().visible and prompt.shown().verb == "Sov", str(prompt.shown()))
	bus.interaction_prompt_changed.emit("")
	for locale in ["da", "en"]:
		lm.set_locale(locale)
		await t.frames(2)
		var rules := UiAudit.rule_report(hud)
		t.check("rules_" + locale, rules.ok, str(rules.defects))
		var focus := UiAudit.focusable_report(hud, {"forbid_focus": true})
		t.check("no_focus_" + locale, focus.ok, str(focus.defects))
		for season in [&"foraar", &"sommer", &"efteraar", &"vinter"]:
			t.expect(not hud.Fmt.date_text(16, season).contains("UI_") and not hud.Fmt.season_day_text(16, season).contains("UI_"), "Four real season names: " + locale + "/" + str(season))
		t.expect(hud.Fmt.date_text(16, &"foraar") == ("Tirsdag 16. Blomstermåned" if locale == "da" else "Tuesday 16. Month of Blooms"), "Real date keys " + locale)
	lm.set_locale("da")
	await t.frames(2)
	qm.reset()
	hud._refresh_quests()
	t.check("quest_card_empty_hidden", not hud.quest_card.visible)
	for id in [&"lost_cat", &"fix_roof", &"birthday_cake", &"forest_patrol"]:
		qm.accept_quest(id)
	await t.frames(2)
	t.check("quest_card_max_three", hud.quest_card.visible and hud.quest_tracker.get_child_count() == 3, str(qm.get_tracked(3)))
	for i in qm.get_tracked(3).size():
		var title: Label = hud.quest_tracker.get_child(i).get_child(0)
		t.expect(title.text == qm.get_title(qm.get_tracked(3)[i]), "Tracker reads runtime quest title")
	var first: StringName = qm.get_tracked(3)[0]
	var objective: StringName = qm.get_current_objective(first)
	qm.update_objective(first, objective, 1)
	await t.frames(2)
	var status: Label = hud.quest_tracker.get_child(0).get_child(1)
	t.check("quest_progress_live", status.text.contains(qm.get_objective_text(first, qm.get_current_objective(first))))
	qm.reset()
	hud._refresh_quests()
	gm.pop_modal(&"hud_test")
	await t.frames(2)
	for index in 8:
		t.tap(StringName("slot_%d" % (index + 1)))
		await t.frames(2)
		t.expect(hud._selected == index and hud.hotbar.get_child(index).button_pressed, "Real slot action " + str(index + 1))
	# Click a slot through GUI input, then verify it reached the production player.
	t.click(hud.hotbar.get_child(1).get_global_rect().get_center())
	await t.frames(3)
	t.check("slot_click_sends_action", t.player().hotbar.selected == 1 and hud._selected == 1)
	t.check("click_never_takes_focus", hud.get_viewport().gui_get_focus_owner() == null)
	var pressed: TTBoxStyle = hud.hotbar.get_child(1).get_theme_stylebox("pressed")
	t.check("hotbar_selected_style", pressed.fill == Color("fffdf6") and pressed.border_width == 3 and pressed.border_color == Color("e3c372") and pressed.ring_colors[0] == Color("2b2340"))
	var entry: Dictionary = t.player().hotbar.entries()[0].duplicate()
	entry.amount = 0
	hud.set_hotbar([entry], 0)
	t.check("zero_count_dimmed", hud.hotbar.get_child(0).modulate.a < 0.5)
	t.player()._emit_hotbar()
	gm.push_modal(&"hud_test", true)
	t.check("visible_while_paused", hud.is_visible_in_tree() and t.tree.paused)
	gm.pop_modal(&"hud_test")
	gm.push_modal(&"hud_test", false)
	t.check("visible_while_cutscene", hud.is_visible_in_tree() and gm.current_phase == gm.GamePhase.CUTSCENE)
	gm.pop_modal(&"hud_test")
	await _toasts(t, hud, ui)
	await _banners(t, hud)
	var source := FileAccess.get_file_as_string("res://scripts/ui/hud.gd")
	t.check("event_driven", not source.contains("func _process") and not source.contains("%02d:%02d"))
	var own_focus: Control = Button.new()
	hud.add_child(own_focus)
	t.check("new_children_focus_none", own_focus.focus_mode == Control.FOCUS_NONE)
	var root_rect := hud.get_global_rect()
	t.check("root_stretch", hud.anchor_right == 1.0 and hud.anchor_bottom == 1.0 and hud.offset_right == 0 and hud.offset_bottom == 0)
	t.check("hotbar_bottom_anchor", is_equal_approx(hud.get_node("%HotbarTray").get_global_rect().end.y, root_rect.end.y - 30.0) and hud.get_node("%HotbarTray").anchor_left == 0.5)
	own_focus.free()

	for id in ["hud", "area_banner"]:
		var audit := await UiAudit.audit_screen(t, id)
		t.check(id + "_registry_live", audit.ok and audit.status == "live", UiAudit.summary(audit))

func _toasts(t, hud: Control, ui: GameUI) -> void:
	var bus: Node = t.autoload("EventBus")
	var stack: ToastStack = hud.toasts
	stack.clear()
	await t.frames(2)
	for i in 12:
		bus.notification_posted.emit("Summary " + str(i), "", "info")
	t.check("toast_queue_holds_eight", stack.toasts().size() == 4 and stack.queued_count() == 8)
	for batch in 3:
		var showing := stack.toasts()
		for i in showing.size():
			t.expect(showing[i].title_label.text == "Summary " + str(batch * 4 + i), "FIFO summary " + str(batch * 4 + i))
		for toast in showing:
			toast.queue_free()
		await t.frames(3)
	t.check("toast_queue_drained", stack.toasts().is_empty() and stack.queued_count() == 0)
	bus.item_gained.emit(&"moonstone", 2)
	bus.notification_posted.emit("NOTIF_ITEM_GAINED_TITLE", "ITEM_MOONSTONE x2", "item")
	var toast: Node = stack.toasts()[0]
	var tile: RaritySlot = toast.get_node("%IconFrame").get_node("RarityTile")
	t.check("toast_rarity_style", tile.rarity == ItemKinds.rarity_of(&"moonstone") and tile.item_id == &"moonstone")
	t.check("toast_keys_translated", toast.title_label.text != "NOTIF_ITEM_GAINED_TITLE" and not toast.message_label.text.contains("ITEM_"))
	var foreign := Control.new()
	t.root.add_child(foreign)
	ui.remove_from_group("game_ui")
	foreign.add_to_group("game_ui")
	t.root.move_child(foreign,0)
	ui.add_to_group("game_ui")
	ui.set_mode(&"action")
	await t.frames(2)
	bus.notification_posted.emit("Summary forest", "", "info")
	t.check("no_double_toast_in_action_mode", stack.toasts().is_empty() and stack.queued_count() == 0 and not hud.visible)
	t.check("toast_uses_own_ui_mode_with_foreign_group_root",t.tree.get_first_node_in_group("game_ui")==foreign and stack.toasts().is_empty())
	foreign.free()
	ui.set_mode(&"farm")
	bus.friend_changed.emit(&"baker_maja", 2)
	await t.frames(2)
	t.check("friend_toast", stack.toasts().size() == 1 and stack.toasts()[0].title_label.text.contains("Rosmarin"))
	stack.clear()
	await t.frames(2)
	var social: Node = t.autoload("SocialManager")
	social.toast_gap_override_ms = 0
	social.on_conversation_finished(&"baker_maja", 1, true)
	await t.frames(3)
	t.check("conversation_heart_toast_coalesced", stack.toasts().size() == 1, str(stack.toasts().size()))
	social.toast_gap_override_ms = -1
	stack.clear()

func _banners(t, hud: Control) -> void:
	var bus: Node = t.autoload("EventBus")
	var gm: Node = t.autoload("GameManager")
	var banner: Control = hud.get_node("%AreaBanner")
	banner._dismiss()
	t.check("area_banner_hidden_initially", not banner.get_node("%Title").visible)
	for id in [&"traetoppen", &"int_froebutikken"]:
		bus.area_changed.emit(id)
		t.check("area_title_" + str(id), banner.get_node("%Title").visible and banner.get_node("%Title").text == tr(WorldRoot2D.load_map(id).title))
	bus.game_event.emit(&"landmark_entered", {"id": "board", "name_key": "BLD_RAADHUSET"})
	t.check("landmark_sub_banner", banner.get_node("%Landmark").visible and banner.get_node("%Landmark").text == tr("BLD_RAADHUSET"))
	gm.push_modal(&"hud_test", false)
	t.check("area_hidden_behind_modal", not banner.get_node("%Title").visible and not banner.get_node("%Landmark").visible)
	gm.pop_modal(&"hud_test")
	bus.load_completed.emit(0)
	t.check("banner_not_on_load", not banner.get_node("%Title").visible)
	bus.area_changed.emit(&"farm")
	await t.seconds(3.2)
	t.check("banner_expires", not banner.get_node("%Title").visible)

func run_windowed(t) -> void:
	t.autoload("EventBus").new_game_started.connect(func(): t.autoload("GameManager").set_flag(GameManager.FLAG_INTRO_PENDING, false), CONNECT_ONE_SHOT)
	await t.start_world()
	var ui: GameUI = t.tree.get_first_node_in_group("game_ui")
	var hud: Control = ui.get_screen(&"hud")
	var gm: Node = t.autoload("GameManager")
	gm.push_modal(&"hud_capture", false)
	hud.toasts.clear()
	hud._gold(1240, 0)
	hud._date(14, &"foraar")
	hud._time(10, 20)
	hud._weather_changed(&"klart")
	hud._stats({"stamina": 72, "max_stamina": 100, "half_hearts": 10, "max_half_hearts": 10})
	hud.get_node("%WhisperLine")._hide()
	hud.get_node("%PromptPill").set_prompt("")
	gm.pop_modal(&"hud_capture")
	# Freeze the world clock without obscuring the HUD.
	gm.set_config_override("time.minutes_per_real_second", 0.0)
	hud.get_node("%AreaBanner")._area_changed(&"traetoppen")
	await t.frames(12)
	await t.capture("farm")
	await _v2_capture(t, hud)
	for locale in ["da", "en"]:
		t.autoload("LocalizationManager").set_locale(locale)
		await t.frames(3)
		var rules := UiAudit.rule_report(hud)
		t.check("native_rules_" + locale, rules.ok, str(rules.defects))
		await t.capture("farm_" + locale)
		t.check("date_left_anchor_" + locale, hud.get_node("%DatePanel").get_global_rect().position == Vector2(40, 40))
		var right: Control = hud.get_node("TopRight")
		t.check("money_right_anchor_" + locale, is_equal_approx(right.get_global_rect().end.x, 1240.0))
	t.autoload("LocalizationManager").set_locale("da")
	gm.clear_config_overrides()
	await t.clear_scene()
	var host := Control.new()
	t.tree.root.add_child(host)
	host.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	var banner: Node = await preload("res://scripts/ui/dev/ui_fixtures.gd").make("area_banner", host)
	await t.frames(2)
	var label: Label = banner.get_node("%Title")
	t.info("Banner outline %d, colour %s" % [label.get_theme_constant("outline_size"), str(label.get_theme_color("font_outline_color"))])
	var banner_shot: Image = await t.capture("area_banner")
	banner_shot.get_region(Rect2i(label.get_global_rect().grow(4))).save_png(t.out_dir.path_join("hud_v2_banner.png"))

	host.free()
	var hud_host := Control.new()
	t.tree.root.add_child(hud_host)
	hud_host.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	await preload("res://scripts/ui/dev/ui_fixtures.gd").make("hud", hud_host)
	await t.frames(2)
	await t.capture("fixture")
	hud_host.free()
	await _compare_v2(t)
	for spec in [["hud_fixture.png", "hud.png"], ["hud_area_banner.png", "area_banner.png"]]:
		var compared: Dictionary = t.run_tool(ProjectSettings.globalize_path("res://tools/art/.venv/bin/python"), PackedStringArray([ProjectSettings.globalize_path("res://tests/checkpoints/compare_guide.py"), t.out_dir.path_join(spec[0]), "--ref", ProjectSettings.globalize_path("res://docs/qa/ui_baseline/" + spec[1]), "--no-frame-crop", "--max", "1.5", "--json"]))
		t.check(spec[1] + "_reviewed_baseline", compared.code == 0, compared.output)

func _v2_capture(t, hud: Control) -> void:
	# The mock uses Tuesday on day 14; runtime calendar correctness is tested above.
	hud.time_label.text = "Tirsdag · 10:20 · Solskin"
	hud.set_hotbar([{"id": "axe_wooden", "amount": 1}, {"id": "watering_can_copper", "amount": 1}, {"id": "turnip_seeds", "amount": 1}, {"id": "carrot", "amount": 1}], 0)
	await t.frames(3)
	var shot: Image = await t.capture("v2")
	var regions := {}
	for spec in [["date", "%DatePanel"], ["chip", "%MoneyChip"], ["hotbar", "%HotbarTray"], ["banner", "%AreaBanner/Body/Title"]]:
		var node: Control = hud.get_node(spec[1])
		var rect := node.get_global_rect()
		regions[spec[0]] = [int(rect.position.x), int(rect.position.y), int(rect.size.x), int(rect.size.y)]
		var crop := shot.get_region(Rect2i(rect))
		crop.save_png(t.out_dir.path_join("hud_v2_" + spec[0] + ".png"))
	var file := FileAccess.open(t.out_dir.path_join("v2-regions.json"), FileAccess.WRITE)
	file.store_string(JSON.stringify(regions, "  "))
	file.close()

func _compare_v2(t) -> void:
	var python: String = ProjectSettings.globalize_path("res://tools/art/.venv/bin/python")
	var prepared: Dictionary = t.run_tool(python, PackedStringArray([ProjectSettings.globalize_path("res://tools/ui/crop_v2_references.py"), "--shots", t.out_dir]))
	t.check("v2_reference_crops", prepared.code == 0, prepared.output)
	for part in ["date", "chip", "banner", "hotbar"]:
		var result: Dictionary = t.run_tool(python, PackedStringArray([ProjectSettings.globalize_path("res://tests/checkpoints/compare_guide.py"), t.out_dir.path_join("comparison_" + part + ".png"), "--ref", t.out_dir.path_join("reference_" + part + ".png"), "--no-frame-crop", "--max", "12", "--json"]))
		var parser := JSON.new()
		var parsed := parser.parse(result.output) == OK
		var comparisons: Array = parser.data.get("screens", {}).values() if parsed and parser.data is Dictionary else []
		t.check("v2_" + part + "_compare", result.code == 0 and comparisons.size() == 1 and float(comparisons[0].get("mean", INF)) <= 12, result.output)
