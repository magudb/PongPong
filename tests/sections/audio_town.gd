extends RefCounted
const SECTION := "audio_town"
const TIMEOUT_S := 120.0
func _has(kind: String,id: String) -> bool:
	return AudioManager.cue_log().any(func(row):return row.kind==kind and row.id==id and row.played)
func run(t) -> void:
	await t.start_world()
	GameManager.set_config_override("time.minutes_per_real_second",0)
	GameManager.set_config_override("towns.curfew.enabled",false)
	AudioManager.clear_cue_log()
	for index in 300:AudioManager.play_sfx("missing_probe_"+str(index))
	var log := AudioManager.cue_log()
	t.check("cue_log_ring_256",log.size()==256 and log[0].id=="missing_probe_44" and not log[255].played and log[255].t_msec>=log[0].t_msec)
	log.clear()
	t.check("cue_log_snapshot_is_detached",AudioManager.cue_log().size()==256)
	AudioManager.clear_cue_log()
	var world: WorldRoot2D = t.world()
	await world.travel(&"hyggebyen",&"default")
	await world.travel(&"int_froebutikken",&"default")
	t.check("cues_follow_area",_has("sfx","shop_bell") and _has("sfx","door_open_wood") and _has("amb","shop_interior"))
	AudioManager.clear_cue_log()
	await world.travel(&"hyggebyen",&"default")
	t.check("exit_shop_bell",_has("sfx","shop_bell"))
	GameManager.hour = 24
	EventBus.time_of_day_changed.emit(24,0)
	t.check("raw_midnight_is_night",_has("amb","town_night"))
	AudioManager.clear_cue_log()
	EventBus.time_of_day_changed.emit(24,1)
	t.check("same_state_no_repeated_ambience",AudioManager.cue_log().all(func(row):return row.kind!="amb"))
	TimeManager.weather = &"regn"
	EventBus.weather_changed.emit(&"regn")
	t.check("rain_overlay",_has("amb","rain") and AudioManager._rain_player.playing)
	await world.travel(&"int_froebutikken",&"default")
	t.check("rain_stops_indoors",not AudioManager._rain_player.playing)
	AudioManager.clear_cue_log()
	for key in ["HOURS_CLOSED_NOW","HOURS_CLOSED_DAY","HOURS_CLOSED_FESTIVAL"]:EventBus.whisper_requested.emit(key)
	EventBus.game_event.emit(&"shop_open_changed",{"shop":"seed_shop","open":false})
	t.check("closed_door_knock_and_closing_bell_hooks",AudioManager.cue_log().filter(func(row):return row.id=="door_locked_knock").size()==3 and _has("sfx","closing_bell"))
	AudioManager.clear_cue_log()
	EventBus.item_purchased.emit(&"cookie",1,12)
	EventBus.friend_changed.emit(&"baker_maja",1)
	for event in ["gift_given","post_read","bath_taken","bin_payout","relationship_changed"]:EventBus.game_event.emit(StringName(event),{})
	t.check("social_cues_logged",["coin_clink","heart_up","gift_sparkle","letter_rustle","bath_splash","bin_bell","stage_up"].all(func(id):return _has("sfx",id)))
	EconomyManager.equip(&"weapon",&"")
	AudioManager.clear_cue_log()
	EconomyManager.equip(&"weapon",&"sword_rusty")
	t.check("real_weapon_equipment_cue",_has("sfx","weapon_equip"))
	AudioManager.clear_cue_log()
	EconomyManager.equip(&"weapon",&"sword_rusty")
	t.check("unchanged_equipment_silent",not _has("sfx","weapon_equip"))
	AudioManager.clear_cue_log()
	GameManager.season = &"foraar"
	GameManager.day = 7
	GameManager.hour = 13
	EventBus.day_started.emit(7,&"foraar")
	SocialManager.flush()
	await t.frames(3)
	t.check("festival_music_and_duck",_has("sfx","festival_horn") and _has("music","festival_foraar") and AudioManager._ambient_duck==-6)
	GameManager.day = 8
	EventBus.day_started.emit(8,&"foraar")
	SocialManager.flush()
	await t.frames(3)
	t.check("festival_restores_area_score",_has("music","city_theme") and AudioManager._ambient_duck==0)
	await _surfaces(t,world)
	await _steps(t,world)
	AudioManager.play_ambience("farm_day",0.05)
	AudioManager.play_ambience("town_night",0.05)
	AudioManager.play_ambience("forest",0.05)
	await t.seconds(0.1)
	t.check("rapid_fades_keep_one_final_stream",AudioManager._ambient_players.filter(func(player):return player.playing).size()==1 and AudioManager._ambient_players[AudioManager._ambient_slot].stream==AudioManager._load_stream(AudioManager.AMBIENT_DIR,"forest"))
	var count := AudioManager.get_children().filter(func(node):return node is AudioStreamPlayer).size()
	t.check("thirteen_plain_players",count==13 and AudioManager.get_children().all(func(node):return not node is AudioStreamPlayer3D))
	for tool in ["sfx_synth.py","ambience_synth.py","music_synth.py"]:
		var result: Dictionary = t.run_tool(t.python(), ["-B",ProjectSettings.globalize_path("res://tools/voice/"+tool),"--check"])
		t.check("recipe_exports_"+tool,int(result.code)==0,str(result.output))
	await t.go_menu()
	await t.seconds(0.4)
	t.check("menu_stops_world_audio",not AudioManager._music_player.playing and not AudioManager._rain_player.playing and AudioManager._ambient_players.all(func(player):return not player.playing))
func _surfaces(t,world: WorldRoot2D) -> void:
	var area := IsoArea.new()
	t.root.add_child(area)
	area.setup(AreaMap.load_file("res://data/maps/_fixture_iso.map"))
	area.map.ground[0] = "dc=p.;f"+area.map.ground[0].substr(7)
	var expected := ["wood","stone","rope","dirt","grass","grass","grass"]
	for x in expected.size():t.check("surface_ground_"+str(x),Surface.at(area,area.cell_to_global(Vector2i(x,0)))==expected[x])
	area.set_meta("surface_fn",func(_point):return "stone")
	t.check("surface_builder_wins",Surface.at(area,area.cell_to_global(Vector2i.ZERO))=="stone")
	area.free()
	await world.travel(&"traetoppen",&"default")
	var builder := CityBuilder.of(world.area)
	var bridge := builder.registry.bridges[0]
	t.check("city_bridge_rope",Surface.at(world.area,bridge.gate_path[bridge.gate_path.size()/2])=="rope")
	var deck := builder.registry.platforms[0]
	t.check("city_platform_wood",Surface.at(world.area,deck.centre+Vector2(deck.rx*0.7,0))=="wood")
	AudioManager.clear_cue_log()
	EventBus.game_event.emit(&"routine_changed",{"hour":12})
	EventBus.game_event.emit(&"routine_changed",{"hour":12})
	t.check("town_bell_once_per_hour",AudioManager.cue_log().filter(func(row):return row.id=="town_bell").size()==1)
func _steps(t,world: WorldRoot2D) -> void:
	var steps := world.player.get_node("Footsteps") as PlayerFootsteps
	steps.set_physics_process(false)
	for running in [false,true]:
		AudioManager.clear_cue_log()
		steps.advance(0,false,false,"wood")
		for frame in 60:steps.advance(1.0/60,true,running,"wood")
		var rows := AudioManager.cue_log()
		t.check("footstep_interval_"+str(running),rows.size()==(4 if running else 3),str(rows))
		var different := true
		for index in range(1,rows.size()):different = different and rows[index].id!=rows[index-1].id
		t.check("no_repeat_variants_"+str(running),different and rows.all(func(row):return row.played))
	AudioManager.clear_cue_log()
	steps.advance(10,false,false,"wood")
	t.check("idle_silent",AudioManager.cue_log().is_empty())
	steps.set_physics_process(true)
	await world.travel(&"farm",&"default")
	await t.physics(4)
	AudioManager.clear_cue_log()
	# Actual input/controller, not just interval helper.
	t.hold(&"move_forward")
	await t.seconds(0.5)
	t.release(&"move_forward")
	await t.physics(2)
	t.check("real_player_walk_emits_steps",AudioManager.cue_log().any(func(row):return str(row.id).begins_with("step_") and row.played))
func run_windowed(t) -> void:
	await run(t)
