extends RefCounted
const SECTION := "wardrobe"
const TIMEOUT_S := 180.0

func run(t) -> void:
	await t.start_world()
	var w: Node = t.autoload("WardrobeManager")
	var eco: Node = t.autoload("EconomyManager")
	var events: Array = []
	var record := func(_player_id: StringName, outfit: Dictionary): events.append(outfit.duplicate())
	EventBus.outfit_changed.connect(record)
	t.check("starter_outfit_and_owned_dress", w.equipped == {"shirt":"shirt_linen_cream", "pants":"pants_trousers_brown", "shoes":"shoes_boots_brown"} and w.count_total("dress_sun_cream") == 1)
	t.check("clothes_use_wardrobe_store", not eco.get_inventory_dict().has(&"shirt_linen_cream") and eco.has_item(&"shirt_linen_cream"))
	var before: Dictionary = w.to_dict()
	t.check("unowned_and_nonclothing_rejected", not w.equip("hat_straw_plain") and not w.equip("iron_sword") and w.to_dict() == before)
	events.clear()
	t.check("dress_equips", w.equip("dress_sun_cream"))
	t.check("dress_exclusion_is_atomic", events.size() == 1 and not events[0].has("shirt") and not events[0].has("pants") and events[0].dress == "dress_sun_cream")
	t.check("displaced_pieces_stay_owned", w.count_total("shirt_linen_cream") == 1 and w.count_stock("shirt_linen_cream") == 1 and w.count_total("pants_trousers_brown") == 1)
	t.check("worn_piece_cannot_be_sold_or_removed", not w.remove("dress_sun_cream") and not eco.remove_item(&"dress_sun_cream"))
	t.check("duplicate_clothing_refused", not eco.add_item(&"dress_sun_cream", 1, true) and w.count_total("dress_sun_cream") == 1)
	w.equip("shirt_linen_cream")
	t.check("shirt_clears_dress_without_equipping_pants", not w.equipped.has("dress") and not w.equipped.has("pants"))
	w.equip("dress_sun_cream")
	w.equip("pants_trousers_brown")
	t.check("pants_clear_dress_without_equipping_shirt", not w.equipped.has("dress") and not w.equipped.has("shirt"))
	eco.add_item(&"hat_straw_plain", 1, true)
	eco.add_item(&"circlet_leaves", 1, true)
	w.equip("hat_straw_plain")
	w.equip("circlet_leaves")
	t.check("circlet_replaces_hat", not w.equipped.has("hat") and w.equipped.circlet == "circlet_leaves" and w.count_stock("hat_straw_plain") == 1)
	w.equip("hat_straw_plain")
	t.check("hat_replaces_circlet", not w.equipped.has("circlet") and w.equipped.hat == "hat_straw_plain")
	var saved: Dictionary = w.outfit()
	t.check("preset_stores_ids", w.save_preset("work"))
	w.unequip("hat")
	w.unequip("pants")
	w.equip("dress_sun_cream")
	var result: Dictionary = w.load_preset("work")
	t.check("preset_restores_exact_outfit", result.ok and result.missing.is_empty() and w.outfit() == saved)
	w.unequip("hat")
	w.remove("hat_straw_plain")
	result = w.load_preset("work")
	t.check("preset_missing_piece_reported_without_duplication", result.ok and result.missing == ["hat_straw_plain"] and not w.equipped.has("hat") and w.count_total("hat_straw_plain") == 0)
	t.check("unknown_preset_refused", not w.save_preset("fourth") and not w.load_preset("fourth").ok)
	var wire: Dictionary = JSON.parse_string(JSON.stringify(w.to_dict()))
	w.reset()
	t.check("json_round_trip", w.from_dict(wire) and JSON.parse_string(JSON.stringify(w.to_dict())) == wire)
	before = w.to_dict()
	t.check("malformed_load_is_atomic", not w.from_dict({"v":1,"owned":[]}) and w.to_dict() == before)
	t.check("malformed_version_is_atomic", not w.from_dict({"v":[]}) and w.to_dict() == before)
	var snapshot: Dictionary = w.outfit()
	snapshot.clear()
	t.check("outfit_snapshot_cannot_mutate_owner", not w.outfit().is_empty())
	t.check("explicit_empty_preview_does_not_restore_other_worn_slots", w.preview_equipping("hat_straw_plain", {}) == {"hat":"hat_straw_plain"})
	var all_valid := true
	for id in ItemKinds.all_ids("clothing"):
		all_valid = all_valid and w.slot_of(id) in w.slots()
	t.check("all_96_items_resolve_to_authored_slots", all_valid and ItemKinds.all_ids("clothing").size() == 96)
	w.reset()
	t.check("starter_set_bonus_uses_real_perks_owner", is_equal_approx(w.gear_points("energy"), 2.0) and Perks.total("energy") >= 2.0)
	var payload: Dictionary = t.autoload("SaveManager").gather_payload()
	payload.erase("wardrobe")
	payload.erase("furniture")
	payload.economy.erase("arsenal")
	payload.economy.inventory.append({"id":"hat_straw_plain","amount":1})
	payload.economy.inventory.append({"id":"chair_pine","amount":5})
	payload.economy.inventory.append({"id":"iron_sword","amount":1})
	var applied: Dictionary = t.autoload("SaveManager")._apply_payload(payload)
	t.check("legacy_save_adopts_backpack_clothes_and_starter_outfit", applied.ok and w.count_total("hat_straw_plain") == 1 and w.equipped.shirt == "shirt_linen_cream" and not eco.get_inventory_dict().has(&"hat_straw_plain"),"apply=%s outfit=%s hat=%d backpack=%s" % [applied,w.outfit(),w.count_total("hat_straw_plain"),eco.get_inventory_dict().has(&"hat_straw_plain")])
	t.check("legacy_furniture_waits_for_its_own_reset",t.autoload("FurnitureManager").count_total("chair_pine") == 5 and not eco.get_inventory_dict().has(&"chair_pine"))
	t.check("legacy_weapon_still_migrates_into_arsenal",eco.arsenal.count_total("iron_sword") == 1 and not eco.get_inventory_dict().has(&"iron_sword"))
	w.reset()
	EventBus.outfit_changed.disconnect(record)
