extends RefCounted
const SECTION := "cheat_menu"
const TIMEOUT_S := 150.0
const Actions := preload("res://scripts/ui/testing/cheat_actions.gd")
var native := false
func run(t) -> void: await _run(t)
func run_windowed(t) -> void:
	native = true
	await _run(t)
func _run(t) -> void:
	await t.start_world()
	var w: WorldRoot2D = t.world()
	var gm: Node = t.autoload("GameManager")
	var eco: Node = t.autoload("EconomyManager")
	var tm: Node = t.autoload("TimeManager")
	var wardrobe: Node = t.autoload("WardrobeManager")
	var menu: TTScreen = w.game_ui.get_screen(&"cheat_menu")
	# REPO-05: the test menu is a debug-build tool. Without debug tools GameUI does not load it and the pause menu has no row for it.
	var gated := GameUI.new()
	gated.debug_tools = false
	var gated_ids := gated.load_screens(GameUI.SCENE_DIR, [&"cheat_menu", &"pause_menu"])
	gated.free()
	var pause_rows := func() -> Array: return w.game_ui.get_screen(&"pause_menu").call("_specs").map(func(row): return str(row[0]))
	w.game_ui._screens.erase(&"cheat_menu")
	var release_rows: Array = pause_rows.call()
	w.game_ui._screens[&"cheat_menu"] = menu
	t.check("test_menu_only_with_debug_tools", GameUI.debug_tools_enabled() and gated_ids == [&"pause_menu"] and not "CheatButton" in release_rows and "CheatButton" in pause_rows.call(), "loaded without debug tools: %s; pause rows without the screen: %s" % [str(gated_ids), str(release_rows)])
	t.tap_key(KEY_F8)
	await t.frames(3)
	t.check("f8_opens_paused_focused_menu", menu.is_open() and menu.is_top() and t.tree.paused and menu.tabs[0].has_focus() and not w.player.world_input_allowed())
	if native: await t.capture("cheats_player")
	var before := int(eco.gold)
	menu._rows[1].emit_signal("pressed")
	t.check("gold_button_uses_economy", eco.gold == before+10000)
	w.player.half_hearts = 1
	w.player.stamina = 1
	w.player.oil = 1
	menu._rows[0].emit_signal("pressed")
	t.check("recovery_refills_all_stats", w.player.half_hearts == w.player.max_half_hearts and w.player.stamina == w.player.max_stamina and w.player.oil == w.player.max_oil)
	var worn: Dictionary = wardrobe.outfit()
	menu._rows[2].emit_signal("pressed")
	var complete := true
	for id in ItemKinds.all_ids("clothing"): complete = complete and wardrobe.count_total(id) > 0
	t.check("unlock_clothing_preserves_independent_outfit", complete and wardrobe.outfit() == worn)
	menu._set_tab(2)
	menu.search.text = "carrot"
	menu._filter_items("carrot")
	var idx: int = menu.item_ids.find("carrot")
	menu.item_picker.select(idx)
	menu.quantity.value = 3
	var carrots: int = eco.count_item(&"carrot")
	t.check("search_and_grant_deliver_real_items", idx >= 0 and menu._grant() and eco.count_item(&"carrot") == carrots+3)
	t.check("invalid_grants_are_atomic", not Actions.grant("not_an_item",1) and not Actions.grant("carrot",0) and not Actions.grant("carrot",1000))
	if native: await t.capture("cheats_items")
	menu._filter_items("__no_match__")
	t.check("empty_search_cannot_grant", menu.item_ids.is_empty() and not menu._grant())
	menu.search.grab_focus()
	t.tap_key(KEY_F8)
	await t.frames(2)
	t.check("f8_closes_while_search_has_focus", not menu.is_open() and not t.tree.paused)
	t.tap_key(KEY_F8)
	await t.frames(2)
	menu._set_tab(3)
	var minutes := int(gm.hour)*60+int(gm.minute)
	t.check("advance_time_uses_clock_owner", Actions.advance(60) and int(gm.hour)*60+int(gm.minute) == minutes+60)
	var day := int(gm.total_day())
	t.check("next_day_runs_calendar", Actions.next_day() and gm.total_day() == day+1 and gm.hour == gm.day_start_hour())
	menu._weather("regn")
	t.check("weather_uses_time_manager", tm.weather == &"regn")
	t.expect_no_raw_keys("menu_localized",menu)
	t.tap_key(KEY_F8)
	await t.frames(3)
	t.check("f8_closes_and_resumes", not menu.is_open() and not t.tree.paused and w.player.world_input_allowed())
	t.tap_key(KEY_ESCAPE)
	await t.frames(3)
	var pause: TTScreen = w.game_ui.get_screen(&"pause_menu")
	pause.get_node("%CheatButton").emit_signal("pressed")
	await t.frames(3)
	t.check("pause_entry_transfers_one_modal", menu.is_open() and not pause.is_open() and gm.modal_stack() == [&"cheats"])
	menu._set_tab(1)
	if native: await t.capture("cheats_travel")
	menu._travel(&"traetoppen",&"default")
	await t.until(func(): return not w.traveling, 12.0)
	t.check("travel_closes_menu_and_enters_real_city", not menu.is_open() and w.area.map.id == &"traetoppen" and not gm.is_modal_open())
	menu.open()
	t.check("city_platform_teleport_relevels_actor", menu._platform(&"c") and ActorLevel.level_id(w.player) == &"c")
	tm.is_paused = true
	tm.from_dict(tm.to_dict())
	t.check("clock_freeze_does_not_survive_load", not tm.is_paused)
	gm.push_modal(&"event",true)
	t.tap_key(KEY_F8)
	await t.frames(2)
	t.check("cannot_open_over_story_modal", not menu.is_open() and gm.top_modal() == &"event")
	gm.pop_modal(&"event")
	w.player.restore_after_sleep()
	await t.frames(2)
