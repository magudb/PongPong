func _crops() -> void:
	var t = _t
	var crops: Dictionary = FarmGrid.crop_definitions()
	var items_by_crop := {}
	for id in _lr.get_all_item_ids():
		var d: Dictionary = _lr.get_item_def(id)
		if d.has("crop_id"):
			items_by_crop[str(d["crop_id"])] = id
	var missing: Array[String] = []
	var waiting: Array[String] = []
	for crop in crops:
		if not items_by_crop.has(crop):
			if crop in CROPS_WAITING_FOR_ITEMS:
				waiting.append(crop)
			else:
				missing.append(crop)
	t.check("crops_have_seed_items", missing.is_empty(), "every crop of game_balance has a seed item with crop_id; missing %s" % str(missing))
	if not waiting.is_empty():
		t.skip("crops_have_seed_items for %s: the seed items arrive with P12 (economy, wave 3)" % ", ".join(waiting))
	for crop in items_by_crop:
		t.expect(crops.has(crop), "the seed item %s names crop_id %s which game_balance defines" % [items_by_crop[crop], crop])
	t.expect(crops.size() == CROPS.size() and CROPS.all(func(c: String) -> bool: return crops.has(c)), "all eleven shipped and winter crops are defined")
	var timing := {"turnip": 4, "carrot": 4, "pumpkin": 10, "moonflower": 12}
	var grow_ok := true
	for crop in timing:
		var days: int = int(crops[crop]["stages"]) * int(crops[crop]["days_per_stage"])
		if days != timing[crop]:
			grow_ok = false
			t.fail("%s grows %d days, the guide says %d" % [crop, days, timing[crop]])
	t.check("crops_complete", grow_ok and int(crops["carrot"]["stages"]) == 4 and int(crops["pumpkin"]["stages"]) == 5 and int(crops["pumpkin"]["days_per_stage"]) == 2, "carrot 4 stages x 1 day, pumpkin 5 stages x 2 days = 10, turnip 4, moonflower 12 days")
	var ww: Dictionary = crops["moonflower"].get("water_window", {})
	t.expect(int(ww.get("from", -1)) == 20 and int(ww.get("to", -1)) == 6 and not crops["carrot"].has("water_window"), "only the moonflower has a water_window (20:00-06:00)")
	var seasons_ok := true
	var all_seasons := ["foraar", "sommer", "efteraar", "vinter"]
	for crop in crops:
		for s in crops[crop]["seasons"]:
			seasons_ok = seasons_ok and (s in all_seasons)
	t.expect(seasons_ok, "every crop season is one of foraar sommer efteraar vinter")
	var chances: Dictionary = _lr.get_config("time.weather_chances", {})
	var weather_ok := chances.size() == 4
	for season in chances:
		var sum := 0.0
		for w in chances[season]:
			sum += float(chances[season][w])
			weather_ok = weather_ok and (str(w) in ["klart", "regn", "taage", "sne", "torden"]) and (str(w) != "sne" or str(season) == "vinter")
		weather_ok = weather_ok and absf(sum - 1.0) < 0.001
	t.expect(weather_ok, "weather chances per season sum to 1 and snow only falls in vinter")


# ---------------------------------------------------------------------------------------------------- tokens and parser

func _tokens_and_parser() -> void:
	var t = _t
	t.expect(LuaTokens.NAME == LuaParser.T_NAME and LuaTokens.NUMBER == LuaParser.T_NUMBER and LuaTokens.STRING == LuaParser.T_STRING and LuaTokens.OP == LuaParser.T_OP, "LuaParser's token constants mirror LuaTokens")
	var tk := LuaTokens.tokenize("x = \"a -- b\" .. 'c' -- tail\n--[[ block\nspans ]] y = 0x1F + 2.5e-3\n")
	var texts: Array = []
	for i in int(tk["count"]):
		texts.append((tk["text"] as PackedStringArray)[i])
	t.expect(texts == ["x", "=", "a -- b", "..", "c", "y", "=", "0x1F", "+", "2.5e-3"], "tokenizer: strings keep `--`, comments (line and block) vanish, numbers keep their exponent: %s" % str(texts))
	t.expect((tk["line"] as PackedInt32Array)[5] == 3 and not (tk["findings"] as Array).is_empty(), "line numbers survive a block comment, and the block comment is a finding")
	# literals and tables
	var src := """kind = "config"
id = "p"
n_int = 5
n_float = 2.5
n_neg = -3
n_hex = 0x10
s = "txt -- not a comment" -- a real comment
flag = true
expr = 5 * 2
config = {
  a = 1, b = "two", c = { 3, 4 }, d = {}, e = { x = { y = { z = 1 } } },
  list = { { id = "one" }, { id = "two", sub = { 1, 2 } } },
  neg = -1.5, keyed = { ["a b"] = 1, [2] = "two" },
  mixed = { x = 1, "dropped" },
  absent = nil,
  text = "line \\"quoted\\"",
  raw = some_name,
  call = f(1, 2),
  trailing = { 1, 2, },
}
"""
	var p: Dictionary = _lr.parse_lua_source(src, "res://x/config/y.lua")
	var a: Dictionary = p["table_assigns"]
	t.check("parser_literals", p["kind"] == "config" and p["id"] == "p" and a["n_int"] == 5 and typeof(a["n_int"]) == TYPE_INT and a["n_float"] == 2.5 and a["n_neg"] == -3 and a["n_hex"] == 16 and a["s"] == "txt -- not a comment" and a["flag"] == true and not a.has("expr"), "ints stay ints, floats floats, negative and hex numbers, `--` inside a string, an expression is not a literal")
	var c: Dictionary = p["config"]
	t.expect(c["a"] == 1 and c["b"] == "two" and c["c"] == [3, 4] and c["e"]["x"]["y"]["z"] == 1, "nested tables and arrays")
	t.expect(typeof(c["d"]) == TYPE_DICTIONARY and (c["d"] as Dictionary).is_empty(), "an empty table `{}` arrives as an empty Dictionary (R.2)")
	t.expect(c["list"].size() == 2 and c["list"][1]["sub"] == [1, 2] and c["list"][0]["id"] == "one", "arrays of tables stay intact")
	t.expect(c["neg"] == -1.5 and c["keyed"]["a b"] == 1 and c["keyed"]["2"] == "two", "negative numbers and [\"key\"] = value entries")
	t.expect(c["mixed"] == {"x": 1}, "a table that mixes named and positional entries keeps the named ones (the lint reports it)")
	t.expect(not c.has("absent"), "`nil` is simply absent")
	t.expect(c["text"] == "line \"quoted\"", "escaped quotes are decoded (the lint reports them): %s" % c["text"])
	t.expect(c["raw"] == "some_name" and c["call"] == "f(1, 2)", "a non-literal value is kept as its source text (the lint reports it)")
	t.expect(c["trailing"] == [1, 2], "a trailing comma is fine")
	# the hoist bug: a table named like a well-known one INSIDE another table is not a top-level table
	var hoist: Dictionary = _lr.parse_lua_source("kind = \"quest\"\nid = \"h\"\nrewards = { gold = 1, items = { carrot = 2 } }\nfunction f(c)\n  return { items = { x = 1 }, lines = { { id = \"a\" } } }\nend\n", "res://lua/quests/h.lua")
	t.check("parser_no_hoist", hoist["rewards"]["items"] == {"carrot": 2} and not hoist.has("items") and not hoist.has("lines"), "rewards.items and the tables of a return are not hoisted to the top level (R.2)")
	t.expect(_lr.parse_lua_source("kind = \"items\"\nitems = { a = { x = 1 } }\n", "")["items"] == {"a": {"x": 1}}, "a real top-level items table is extracted")
	# functions
	var fp: Dictionary = _lr.parse_lua_source(FileAccess.get_file_as_string(FIX + "p01_empty_fn.lua"), "res://lua/quests/p01.lua")
	t.check("parser_empty_function", (fp["functions"] as Dictionary).keys() == ["a", "b"] and LuaParser.compile_body(str(fp["functions"]["a"]["body"])).is_empty() and fp["functions"]["b"]["params"] == ["context"] and str(fp["functions"]["b"]["body"]).contains("return"), "an empty / comment-only function no longer swallows the next one (intro_lottery.lua)")
	var real_intro: Dictionary = _lr.parse_lua_source(FileAccess.get_file_as_string("res://lua/quests/intro_lottery.lua"), "res://lua/quests/intro_lottery.lua")
	var fnames: Array = (real_intro["functions"] as Dictionary).keys()
	t.expect("on_day_started" in fnames and "is_available" in fnames and fnames.size() == 5, "intro_lottery.lua: on_day_started (comment only) and is_available are separate functions: %s" % str(fnames))
	t.expect(_lr._find_comment("x = \"a -- b\" -- c") == 13 and _lr._find_comment("none") == -1 and _lr._find_comment("x = \"a\\\" -- b\" -- c") == 15, "_find_comment skips `--` inside strings (also after an escaped quote)")
	var named: Dictionary = {}
	_lr._extract_named_table("rewards = { gold = 3 }\nmeta = { giver = \"x\" }", "rewards", named)
	t.expect(named == {"rewards": {"gold": 3}}, "_extract_named_table keeps working for tools")
	# a `tables` header
	var th: Dictionary = _lr.parse_lua_source(FileAccess.get_file_as_string(FIX + "tables_header.lua"), "res://x/tables_header.lua")
	t.check("parser_tables_header", th["tables"] == ["alpha", "beta", "gamma"] and th["alpha"] == {"x": 1} and th["beta"]["y"] == [1, 2, 3], "top-level tables named in a `tables` header are extracted")


# ---------------------------------------------------------------------------------------------------- lint

func _lint_rules() -> void:
	var t = _t
	var cases := [
		["for", "function f()\n  for i = 1, 3 do\n    api.add_gold(1)\n  end\nend", "loop"],
		["while", "function f(c)\n  while c do\n    c = false\n  end\nend", "loop"],
		["repeat", "function f()\n  repeat\n    api.add_gold(1)\n  until true\nend", "loop"],
		["block comment", "--[[ commented out ]]\nfunction f() end", "long_bracket"],
		["long string", "config = { a = [[text]] }", "long_bracket"],
		["local function", "local function g()\n  return 1\nend", "local_function"],
		["function M.f", "local M = {}\nfunction M.f()\n  return 1\nend", "module_function"],
		["method definition", "function obj:method()\n  return 1\nend", "module_function"],
		["escaped quote", "config = { a = \"say \\\"hi\\\"\" }", "escape"],
		["hash", "function f(t)\n  return #t\nend", "length"],
		["string.", "function f()\n  return string.upper(\"a\")\nend", "stdlib"],
		["math.", "function f()\n  return math.floor(1.5)\nend", "stdlib"],
		["table.", "function f(t)\n  table.insert(t, 1)\nend", "stdlib"],
		["plus", "function f(a)\n  local b = a + 1\nend", "arithmetic"],
		["times", "function f(a)\n  local b = a * 2\nend", "arithmetic"],
		["binary minus", "function f(a)\n  local b = a - 1\nend", "arithmetic"],
		["method call", "function f(s)\n  return s:upper()\nend", "method_call"],
		["vararg", "function f(...)\n  return 1\nend", "vararg"],
		["mixed table", "config = { a = 1, \"positional\" }", "mixed_table"],
		["nil value", "config = { a = nil }", "nil_value"],
		["identifier value", "config = { a = some_name }", "table_value"],
		["call value", "config = { a = f(1) }", "table_value"],
		["expression in a data table", "config = { a = 1, b = c.n or 2 }", "table_value"],
		["concat value", "config = { a = \"x\" .. \"y\" }", "table_value"],
		["unclosed if", "function f(c)\n  if c then\n    return 1\nend", "unbalanced"],
		["stray end", "function f()\nend\nend", "unbalanced"],
		["unterminated string", "config = { a = \"abc\n}", "unterminated_string"],
		# not Lua at all, or Lua the subset would run differently (LUA-01): the parser's grammar findings and the deny-list
		["not equal written !=", "function f(c)\n  if c.n != 3 then\n    return 1\n  end\nend", "stray_character"],
		["!= leaves the if without then", "function f(c)\n  if c.n != 3 then\n    return 1\n  end\nend", "syntax"],
		["= in a condition", "function f(c)\n  if c.n = 3 then\n    return 1\n  end\nend", "syntax"],
		["misspelt return", "function f(c)\n  retrun false\n  return true\nend", "syntax"],
		["statement after return", "function f(c)\n  return 1\n  api.add_gold(1)\nend", "syntax"],
		["unclosed parenthesis", "function f(c)\n  return (c.a or c.b\nend", "syntax"],
		["local list", "function f(c)\n  local a, b = 1, 2\n  return a\nend", "local_list"],
		["field assignment", "function f(c)\n  c.seen = true\n  return c\nend", "field_assignment"],
		["function value", "function f(c)\n  local g = function() return 1 end\n  return g\nend", "function_value"],
		["nested function", "function f(c)\n  function g()\n    return 1\n  end\nend", "function_value"],
		["unknown api function", "function f(c)\n  api.add_gld(5)\nend", "unknown_function"],
		["unknown bare function", "function f(c)\n  return helper(c)\nend", "unknown_function"],
		["call of a field", "function f(c)\n  return c.compute(1)\nend", "unknown_function"],
		["question mark", "function f(c)\n  return c ? 1\nend", "stray_character"],
		["at sign", "function f(c)\n  return @c\nend", "stray_character"],
		["break", "function f(c)\n  break\nend", "loop"],
		["top-level local", "local x = 1", "top_level"],
		["top-level expression", "x = \"a\" .. \"b\"", "top_level"],
		["top-level call", "api.add_gold(1)", "top_level"],
	]
	var all_ok := true
	for c in cases:
		var findings: Array = _lr.lint_source("kind = \"config\"\n" + str(c[1]) + "\n", "res://x.lua")
		var rules := _rules_of(findings)
		if not (str(c[2]) in rules):
			all_ok = false
			_t.fail("lint rule %s: `%s` was not reported (got %s)" % [c[2], c[0], str(rules)])
	var clean_cases := [
		["unary minus", "config = { a = -1, b = -2.5 }"],
		["concat in a call", "function f()\n  api.log(\"a\" .. \"b\")\nend"],
		["comparisons and nil", "function f(c)\n  if c == nil or c ~= 1 or c >= 2 or c <= 3 or c < 4 or c > 5 then\n    return 1\n  end\nend"],
		["hash and words in strings", "config = { c = \"#fff\", t = \"else for while [[x]] a + b\" }"],
		["nested tables", "config = { a = { { b = { 1, 2 } }, { c = true } } }"],
		["negative after return", "function f()\n  return -1\nend"],
		["one-line if", "function f(c)\n  if c then return 1 end\nend"],
		["exponent", "config = { a = 1e-3, b = 2E+5 }"],
		["comments", "-- else for while\nconfig = { a = 1 } -- trailing # comment"],
		["api calls and bare queries", "function f(c)\n  if api.has_flag(\"x\") and has_item(\"y\", 2) then\n    api.add_gold(1)\n  end\n  return api.get_flag(\"z\")\nend"],
		["do block and a return with ;", "function f(c)\n  do\n    local x = c.n\n  end\n  return 1;\nend"],
		["assignment to a name", "function f(c)\n  local n = 1\n  n = c.n or n\n  return n\nend"],
		["else and elseif", "function f(c)\n  if c.a then\n    return 1\n  elseif c.b then\n    return 2\n  else\n    return 3\n  end\nend"],
		["a table built in a function evaluates its values", "function f(c)\n  local key = c.k or \"A\"\n  return { text_key = key, n = c.n, seen = api.has_flag(\"x\"), nested = { who = c.who }, [\"k\"] = c.k }\nend"],
	]
	for c in clean_cases:
		var findings: Array = _lr.lint_source("kind = \"config\"\n" + str(c[1]) + "\n", "res://x.lua")
		if not findings.is_empty():
			all_ok = false
			_t.fail("lint false positive on `%s`: %s" % [c[0], str(_rules_of(findings))])
	# whole fixtures
	var expect_files := {
		"lint_bad_tables.lua": ["mixed_table", "nil_value", "table_value", "arithmetic"],
		"lint_bad_blocks.lua": ["unbalanced"],
		"lint_stdlib.lua": ["stdlib", "loop", "method_call"],
		"lint_no_kind.lua": ["kind_missing"],
		"lint_bad_kind.lua": ["kind_unknown"],
	}
	for f in expect_files:
		var rules := _rules_of(_lr.lint_source(FileAccess.get_file_as_string(FIX + f), FIX + f))
		for want in expect_files[f]:
			if not (want in rules):
				all_ok = false
				_t.fail("%s: rule %s missing (got %s)" % [f, want, str(rules)])
	t.check("lint_rules", all_ok, "%d bad snippets flagged by their rule, %d good snippets clean, 5 bad fixture files" % [cases.size(), clean_cases.size()])
	# the review's cases (LUA-01): each ran silently wrong with an empty lint report before the grammar findings
	var silently_wrong := {
		"`!=`": "kind = \"dialogue\"\nfunction get_dialogue(context)\n  if context.weekday != 2 then\n    return { r = \"open\" }\n  end\n  return { r = \"closed\" }\nend\n",
		"`if n = 3`": "kind = \"dialogue\"\nfunction get_dialogue(context)\n  if context.n = 3 then\n    return { r = \"three\" }\n  end\nend\n",
		"`retrun`": "kind = \"quest\"\nfunction is_available(context)\n  retrun false\n  return true\nend\n",
		"`local a, b`": "kind = \"dialogue\"\nfunction get_dialogue(context)\n  local a, b = 1, 2\n  return { r = a }\nend\n",
		"field assignment": "kind = \"dialogue\"\nfunction get_dialogue(context)\n  context.seen = true\n  return { r = context.seen }\nend\n",
		"function value": "kind = \"dialogue\"\nfunction get_dialogue(context)\n  local f = function() return 1 end\n  return { r = f }\nend\n",
	}
	var still_clean: Array[String] = []
	for label in silently_wrong:
		if _lr.lint_source(str(silently_wrong[label]), "res://x.lua").is_empty():
			still_clean.append(str(label))
	t.check("lint_rejects_invalid_lua", still_clean.is_empty(), "invalid or out-of-subset Lua is never lint clean (%d review cases); clean: %s" % [silently_wrong.size(), str(still_clean)])
	var where: Array = _lr.lint_source("kind = \"quest\"\n\nfunction is_available(context)\n  local x = 1\n  retrun false\nend\n", "res://some/q.lua")
	t.expect(where.size() == 1 and int(where[0]["line"]) == 5 and str(where[0]["rule"]) == "syntax" and str(where[0]["token"]) == "retrun", "a grammar finding names its line and token: %s" % str(where))
	# findings carry what a tool needs
	var one: Array = _lr.lint_source("kind = \"config\"\nfunction f()\n  return 1 + 2\nend\n", "res://some/file.lua")
	t.expect(not one.is_empty() and one[0]["path"] == "res://some/file.lua" and int(one[0]["line"]) == 3 and str(one[0]["rule"]) == "arithmetic" and str(one[0]["message"]) != "", "a finding has path, line, rule, token and message (%s)" % str(one))
	# the data-level lint of the loader: rarity not on the ladder, tables header without its table
	var mark: int = t.log_mark()
	_lr.load_file(FIX + "lint_bad_rarity.lua")
	_lr.load_file(FIX + "tables_header.lua")
	var rules_now := _rules_of(_lr.lint_report)
	t.check("lint_data_level", ("rarity" in rules_now) and ("tables_header" in rules_now), "`epic` is a lint error (rarity ladder) and a `tables` header without its table is reported: %s" % str(rules_now))
	t.expect_clean_since(mark, "loading files with lint findings logs no engine warning")
	_lr.reload_scripts()
	t.expect(_lr.lint_report.is_empty(), "reload_scripts clears the previous findings")
	# a release build skips the subset lint at load but keeps the data-level checks of the loader
	_lr.lint_on_load = false
	_lr.load_file(FIX + "lint_bad_rarity.lua")
	_lr.load_file(FIX + "p07_arith.lua")
	var release_rules := _rules_of(_lr.lint_report)
	_lr.lint_on_load = OS.is_debug_build()
	_lr.reload_scripts()
	t.check("lint_skipped_without_lint_on_load", release_rules == ["rarity"], "without lint_on_load only the data-level findings are reported (the arithmetic of p07 is not): %s" % str(release_rules))


func _lint_clean() -> void:
	var t = _t
	_lr.reload_scripts()
	var summary: Array[String] = []
	for f in _lr.lint_report:
		summary.append(str(f["path"]).get_file() + ":" + str(f["line"]) + " " + str(f["rule"]))
	t.check("lint_clean", _lr.lint_report.is_empty(), "every Lua file under res://lua lints clean (%d scripts); findings: %s" % [_lr.get_all_script_ids().size(), str(summary.slice(0, 8))])
	for fx in ["lint_clean_sample.lua", "flag_identifiers.lua", "semantics.lua", "shops_extra.lua", "recipes_extra.lua", "data/data_config.lua", "data/data_items.lua", "p01_empty_fn.lua", "p02_else.lua", "p03_elseif.lua", "p04_nested_if.lua", "p06_ternary.lua", "p10_get_flag.lua", "p17_ifelse_api.lua", "p24_block_scope.lua", "p25_float_index.lua", "p26_table_values.lua", "p05_oneline_if.lua", "p08_paren_in_string.lua", "p09_emit_payload.lua", "p14_two_ifs.lua", "p18_compare_and_or.lua", "p19_return_expr.lua", "p20_local_in_untaken.lua", "p21_multiline_api.lua", "p23_stmt_around_if.lua"]:
		var findings: Array = _lr.lint_source(FileAccess.get_file_as_string(FIX + fx), FIX + fx)
		t.expect(findings.is_empty(), "fixture %s is inside the subset and lints clean %s" % [fx, str(_rules_of(findings))])
	_real_lua_syntax()
