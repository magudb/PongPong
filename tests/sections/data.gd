			"price_curve": curve["repeat_surcharge"] == {"step": 0.08, "max": 0.32} and curve["friend_discount"]["per_heart"] == 0.005 and curve["friend_discount"]["max_hearts"] == 10,
			"sales array of tables": curve["sales"].size() == 2 and curve["sales"][0]["from_day"] == 22 and curve["sales"][0]["rarity"] == ["uncommon"] and curve["sales"][1]["rarity"] == ["normal", "uncommon"],
		}
