func _race_perks() -> void:
	var t = _t
	var all_ok := true
	for race in RACES:
		var cfg: Dictionary = _lr.get_config("race_perks.%s" % race, {})
		for k in PERK_KEYS:
			if not cfg.has(k):
				all_ok = false
				t.fail("race_perks.%s has no key %s" % [race, k])
		var skins: Array = cfg.get("skins", [])
		var species: Array = cfg.get("species", [])
		# the chip list = the heroes of the race (two per race since the Figurer v2 cards); `skins` is the full list of the race, retired rows included
		var heroes_of_race := 0
		for h in LuaData.arr(_lr.get_config("characters.heroes", [])):
			if str(LuaData.dict(h).get("race", "")) == race:
				heroes_of_race += 1
		t.expect(skins.size() >= 2 and species.size() == heroes_of_race and species.size() == 2 and species.size() <= skins.size() and str(cfg.get("default_skin", "")) in skins, "%s: two hero chips (%d heroes in characters.lua), the skins list incl. retired rows (%d), default skin among them" % [race, heroes_of_race, skins.size()])
	t.check("race_perks_complete", all_ok, "animal, fairy, hobbit and ghost define every perk key (neutral values where the race has no perk), incl. the eight keys of the ghost's perk layer")
	var animal: Dictionary = _lr.get_config("race_perks.animal", {})
	var fairy: Dictionary = _lr.get_config("race_perks.fairy", {})
	var hobbit: Dictionary = _lr.get_config("race_perks.hobbit", {})
	var ghost: Dictionary = _lr.get_config("race_perks.ghost", {})
	t.expect(animal["dig_speed"] == 1.3 and animal["tool_cost_mult"] == 0.75 and animal["harvest_bonus_chance"] == 0.2 and animal["can_fly"] == false, "animal: dig_speed 1.3, tool_cost_mult 0.75, harvest_bonus_chance 0.2")
	t.expect(fairy["can_fly"] == true and fairy["flight_max_seconds"] == 8.0 and fairy["flight_energy_per_second"] == 10 and fairy["talks_to_flowers"] == true, "fairy: can_fly, 8 s, 10 energy/s, talks_to_flowers")
	t.expect(hobbit["shop_discount"] == 0.1 and hobbit["bake_bonus"] == 0.25 and hobbit["can_fly"] == false, "hobbit: shop_discount 0.1, bake_bonus 0.25 (+25% output chance in the crafting category bake)")
	t.expect(ghost["run_cost_mult"] == 0.6 and ghost["oil_use_mult"] == 0.75 and ghost["dark_light_mult"] == 1.25 and ghost["float_bob_px"] == 2.5 and ghost["glow_energy"] == 0.35 and ghost["shop_discount"] == 0.0 and ghost["bake_bonus"] == 0.0 and ghost["can_fly"] == false, "ghost: run_cost_mult 0.6, oil_use_mult 0.75, dark_light_mult 1.25, float_bob_px 2.5, glow_energy 0.35, no discount, no bake bonus, no flight")
	var only_hobbit_discounts: bool = animal["shop_discount"] == 0.0 and fairy["shop_discount"] == 0.0 and ghost["shop_discount"] == 0.0 and animal["bake_bonus"] == 0.0 and fairy["bake_bonus"] == 0.0 and ghost["bake_bonus"] == 0.0
	t.expect(only_hobbit_discounts and animal["species"] == ["fox", "monkey"] and fairy["species"] == ["meadow", "birk"] and hobbit["species"] == ["bertil", "bodil"] and ghost["species"] == ["bu", "hviske"], "only the hobbit has discount and bake perks; the chips are Ræv/Abe, Kløvermynte/Birk, Bertil/Bodil and Bu/Hviske (two heroes per race)")
	# characters.lua (P05, same wave) is the owner of the skins: the lists here must agree with it once it exists
	var characters: Variant = _lr.get_config("characters", null)
	if typeof(characters) == TYPE_DICTIONARY and (characters as Dictionary).has("skins"):
		var agree := true
		for race in RACES:
			var from_chars: Array[String] = []
			for skin_id in characters["skins"]:
				if str(characters["skins"][skin_id].get("race", "")) == race:
					from_chars.append(str(skin_id))
			var mine: Array = _lr.get_config("race_perks.%s.skins" % race, [])
			mine = mine.map(func(s: Variant) -> String: return str(s))
			from_chars.sort()
			mine.sort()
			if from_chars != mine:
				agree = false
				t.fail("race %s: skins in race_perks.lua %s differ from characters.lua %s" % [race, mine, from_chars])
			var d: Variant = characters.get("races", {}).get(race, {}).get("default_skin", "")
			if str(d) != str(_lr.get_config("race_perks.%s.default_skin" % race, "")):
				agree = false
				t.fail("race %s: default_skin differs from characters.lua" % race)
		t.check("race_skins_match_characters", agree, "race_perks.lua skins / default_skin agree with lua/config/characters.lua (P05)")
	else:
		t.skip("race_skins_match_characters: lua/config/characters.lua (P05) is not loaded yet")


