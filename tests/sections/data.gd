var _t
var _lr: Node
var _gm: Node
var _eco: Node
var _bus: Node
var _saved_flags: Dictionary = {}
var _saved_gold: int = 0
var _captured_notifs: Array = []
var _captured_emits: Array = []


func run(t) -> void:
	_t = t
	_lr = t.autoload("LuaRuntime")
	_gm = t.autoload("GameManager")
	_eco = t.autoload("EconomyManager")
	_bus = t.autoload("EventBus")
	if _lr == null or _gm == null or _bus == null:
		t.fail("LuaRuntime / GameManager / EventBus autoloads are missing")
		return
	_saved_flags = (_gm.world_flags as Dictionary).duplicate(true)
	_saved_gold = int(_eco.gold) if _eco != null else 0
	_bus.notification_posted.connect(_on_notification)
	_bus.lua_event.connect(_on_lua_event)
	_boot()
	_config_keys()
	_numbers_positive()
	_roster()
	_race_perks()
	_crops()
	_tokens_and_parser()
	_lint_rules()
	_lint_clean()
	_probes()
	_flag_identifiers()
	_semantics()
	_kinds()
	_passthrough()
	_hot_reload_consumers()
	_svc()
	_helpers()
	# leave the runtime and the game state as found (fixtures were loaded through load_file)
	_bus.notification_posted.disconnect(_on_notification)
	_bus.lua_event.disconnect(_on_lua_event)
	_lr.reload_scripts()
	_restore_state()


# ---------------------------------------------------------------------------------------------------- boot

func _boot() -> void:
	var t = _t
	var before_scripts: int = _lr.get_all_script_ids().size()
	var before_items: int = _lr.get_all_item_ids().size()
	var before_quests: int = _lr._quest_modules.size()
	var mark: int = t.log_mark()
	_lr.reload_scripts()
	t.expect_clean_since(mark, "reload_scripts logs no engine error or warning (the untranslated-key format error of lua_runtime.gd:42 is gone)")
	t.check("reload_idempotent", _lr.get_all_script_ids().size() == before_scripts and _lr.get_all_item_ids().size() == before_items and _lr._quest_modules.size() == before_quests, "%d scripts, %d items, %d quests before and after" % [before_scripts, before_items, before_quests])
	t.check("lua_load_time", t.perf_ok("lua_load_time", float(_lr.load_ms), 1500.0), "loading every Lua file (one tokenizer pass for lint and parser) takes %d ms, reference 1500 ms" % int(_lr.load_ms))
	t.check("lint_on_load_only_in_debug_builds", _lr.lint_on_load == OS.is_debug_build(), "the load-time lint runs only when OS.is_debug_build() (%s); CI enforces lint_clean, a release build skips it" % str(OS.is_debug_build()))
	t.check("f9_only_in_debug_builds", _lr.is_processing_unhandled_key_input() == OS.is_debug_build(), "F9 hot reload is bound only when OS.is_debug_build() (%s)" % str(OS.is_debug_build()))
	t.expect(_lr.has_method("get_recipes") and _lr.has_method("get_shop") and _lr.has_method("get_npc") and _lr.has_method("reload_scripts") and _lr.has_method("lint_source"), "LuaRuntime exposes get_recipes, get_shop, get_npc, reload_scripts, lint_source")
	# the announcement of an explicit reload (F9) carries the count and never trips over an untranslated key
	_captured_notifs.clear()
	mark = t.log_mark()
	_lr.reload_scripts(true)
	t.expect(_captured_notifs.size() == 1 and str(_captured_notifs[0][1]).contains(str(_lr.get_all_script_ids().size())), "reload_scripts(true) posts one toast that names the script count: %s" % str(_captured_notifs))
	_captured_notifs.clear()
	var f9 := InputEventKey.new()
	f9.keycode = KEY_F9
	f9.pressed = true
	_lr._unhandled_key_input(f9)
	t.expect(_captured_notifs.size() == (1 if OS.is_debug_build() else 0), "the F9 key reloads and announces (debug build only): %d toast(s)" % _captured_notifs.size())
	var other := InputEventKey.new()
	other.keycode = KEY_F8
	other.pressed = true
	_captured_notifs.clear()
	_lr._unhandled_key_input(other)
	t.expect(_captured_notifs.is_empty(), "any other key does nothing")
	# a hot reload with lint findings says so in a second toast (LUA-04): F9 must not hide a broken file
	_lr.lint_report.append({"path": "res://x.lua", "line": 1, "rule": "syntax", "token": "x", "message": "injected for the test"})
	_captured_notifs.clear()
	_lr._announce_reload()
	t.check("f9_toast_names_lint_findings", _captured_notifs.size() == 2 and str(_captured_notifs[1][1]).contains("1") and str(_captured_notifs[1][1]) != "NOTIF_LUA_RELOADED_LINT", "the reload toast is followed by one that counts the lint findings: %s" % str(_captured_notifs))
	_lr.reload_scripts()
	t.expect_clean_since(mark, "explicit reloads log no engine error or warning")
	# tr() of an untranslated key must never be formatted
	var text: String = _lr._format_count("NOTIF_LUA_RELOADED_MSG", 7)
	t.expect(text.contains("7"), "an untranslated key is not %%-formatted (got '%s')" % text)
	t.expect(_lr._format_count("%d scripts loaded", 7) == "7 scripts loaded", "a translated text with %d gets the count")


