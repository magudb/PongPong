# ---------------------------------------------------------------------------------------------------- Svc

func _svc() -> void:
	var t = _t
	# a stand-in for a class that a later package adds (F4's PriceCurve): written to user:// like a package would add a script
	var path := "user://p10_price_curve_probe.gd"
	var f := FileAccess.open(path, FileAccess.WRITE)
	f.store_string("extends RefCounted\n\nstatic func final_price(base: int, discount: float) -> int:\n\treturn roundi(float(base) * (1.0 - minf(discount, 0.2)))\n\nfunc instance_method() -> int:\n\treturn 1\n")
	f.close()
	var fox: Variant = Svc.static_call(path, &"final_price", [1600, 0.15], -1)
	var hobbit: Variant = Svc.static_call(path, &"final_price", [1600, 0.25], -1)
	var alone: Variant = Svc.static_call(path, &"final_price", [1600, 0.10], -1)
	var missing_script: Variant = Svc.static_call("user://p10_no_such_script.gd", &"final_price", [1600, 0.15], "fallback")
	var missing_method: Variant = Svc.static_call(path, &"no_such_method", [1], "fallback")
	var instance_method: Variant = Svc.static_call(path, &"instance_method", [], "fallback")
	var mark: int = t.log_mark()
	var res_missing: Variant = Svc.static_call("res://scripts/economy/definitely_not_there.gd", &"x", [], 42)
	var real_class: Variant = Svc.static_call("res://scripts/data/rarity.gd", &"rank", ["rare"], -1)
	var no_args: Variant = Svc.static_call("res://scripts/data/rarity.gd", &"ids", [], [])
	t.check("svc_static_call_fallbacks", fox == 1360 and hobbit == 1280 and alone == 1440 and missing_script == "fallback" and missing_method == "fallback" and instance_method == "fallback" and res_missing == 42 and real_class == 3 and (no_args as Array).size() == 5, "1600 gold: %s / %s / %s (1360 / 1280 / 1440); missing script, missing method, instance method and missing res:// script give the fallback; a real static class answers" % [fox, hobbit, alone])
	t.expect_clean_since(mark, "static_call of a missing script logs no engine error")
	DirAccess.remove_absolute(ProjectSettings.globalize_path(path))
	# a res:// answer is remembered (QUAL-01: resolving cost 24-77 µs a call on per-tick paths); a user:// probe is not
	Svc.static_call("res://scripts/data/rarity.gd", &"rank", ["rare"], -1)
	var calls := 2000
	var t0 := Time.get_ticks_usec()
	for i in calls:
		Svc.static_call("res://scripts/data/rarity.gd", &"rank", ["rare"], -1)
	var per_call := float(Time.get_ticks_usec() - t0) / float(calls)
	t.check("svc_static_call_memoised", Svc._resolved.get("res://scripts/data/rarity.gd::rank", null) is Script and not Svc._resolved.has(path + "::final_price") and t.perf_ok("svc_static_call_us", per_call, 6.0), "a res:// static function is resolved once and then costs %.1f µs a call (reference 6 µs; the user:// probe is not remembered)" % per_call)
	# a shipped script without the static function is a broken contract: the fallback, and ONE engine warning (QUAL-08)
	t.allow("Svc.static_call: res://scripts/data/rarity.gd has no static function no_such_function()")
	var broken_a: Variant = Svc.static_call("res://scripts/data/rarity.gd", &"no_such_function", [], "fallback")
	var broken_b: Variant = Svc.static_call("res://scripts/data/rarity.gd", &"no_such_function", [], "fallback")
	t.check("svc_static_call_warns_once_on_a_broken_contract", broken_a == "fallback" and broken_b == "fallback" and t.allowed_count("Svc.static_call: res://scripts/data/rarity.gd has no static function no_such_function()") == 1, "a res:// script without the static function answers the fallback and warns once (%d warning(s))" % t.allowed_count("Svc.static_call: res://scripts/data/rarity.gd has no static function no_such_function()"))
	# autoload lookup, overrides
	t.expect(Svc.node("LuaRuntime") == _lr and Svc.node("DefinitelyNoAutoload") == null and Svc.lua_config("player.walk_speed", 0) == 285 and Svc.lua_config("no.such.path", "d") == "d", "Svc.node / Svc.lua_config look the autoload up at call time")
	var fake := Node.new()
	Svc.override("FurnitureManager", fake)
	var overridden: bool = Svc.node("FurnitureManager") == fake and Svc.has_override("FurnitureManager")
	Svc.override("LuaRuntime", fake)
	var shadows_real: bool = Svc.node("LuaRuntime") == fake
	Svc.clear_overrides()
	t.check("svc_override", overridden and shadows_real and Svc.node("LuaRuntime") == _lr and Svc.node("FurnitureManager") != fake and not Svc.has_override("FurnitureManager"), "Svc.override injects a fake autoload, clear_overrides removes every one of them")
	var gone := Node.new()
	Svc.override("HomeManager", gone)
	gone.free()
	var after_free: Node = Svc.node("HomeManager")
	t.expect(after_free == null or is_instance_valid(after_free), "a fake that was freed is dropped, not returned")
	Svc.clear_overrides()
	fake.free()


# ---------------------------------------------------------------------------------------------------- LuaData / SaveCodec

func _helpers() -> void:
	var t = _t
	# LuaData: `{}` as Dictionary or Array, JSON numbers as float
	t.expect(LuaData.dict({}) == {} and LuaData.dict([]) == {} and LuaData.arr({}) == [] and LuaData.arr([1]) == [1] and LuaData.dict(5) == {} and LuaData.arr(null) == [], "dict() and arr() accept `{}` as either type")
	t.expect(LuaData.int_of(3.0) == 3 and LuaData.int_of("4") == 4 and LuaData.int_of("2.9") == 2 and LuaData.int_of(null, 9) == 9 and LuaData.int_of(true, 7) == 7 and typeof(LuaData.int_of(5.0)) == TYPE_INT, "int_of")
	t.expect(LuaData.num(2) == 2.0 and LuaData.num("1.5") == 1.5 and LuaData.num("x", 3.0) == 3.0 and LuaData.num(null) == 0.0, "num")
	t.expect(LuaData.strings(["a", 2, &"c"]) == ["a", "2", "c"] and LuaData.strings({}) == [], "strings")
	t.expect(LuaData.int_map({"a": 2.0, "b": "5"}) == {"a": 2, "b": 5} and LuaData.int_map([]) == {} and LuaData.int_map({}) == {}, "int_map coerces counts and accepts `{}`")
	# SaveCodec (facts verified in Godot 4.7.2)
	var d := {"n": 5, "big": 250000, "cell": Vector2i(3, 4), "id": &"hat_straw", "nested": {&"k": 2}}
	var back: Variant = SaveCodec.through_json(d)
	t.expect(typeof(back["n"]) == TYPE_FLOAT and str(back["n"]) == "5.0", "(fact) JSON returns ints as float")
	t.expect(SaveCodec.to_int(back["n"]) == 5 and typeof(SaveCodec.to_int(back["n"])) == TYPE_INT, "SaveCodec.to_int restores an int")
	t.expect(typeof(back["cell"]) == TYPE_STRING and back["cell"] == "(3, 4)", "(fact) a Vector2i becomes the string '(3, 4)' in JSON: cells are stored as [x, z]")
	t.expect(SaveCodec.cell_from_json(SaveCodec.through_json({"c": SaveCodec.cell_to_json(Vector2i(7, 9))})["c"]) == Vector2i(7, 9), "a cell survives a JSON round trip as [x, z]")
	var cells: Array[Vector2i] = SaveCodec.cells_from_json(SaveCodec.through_json(SaveCodec.cells_to_json([Vector2i(1, 2), Vector2i(-3, 4)])))
	t.expect(cells == [Vector2i(1, 2), Vector2i(-3, 4)] and SaveCodec.cells_from_json("bad").is_empty() and SaveCodec.cells_from_json([[1], [2, 3]]) == [Vector2i(2, 3)], "cell arrays round trip, malformed entries are skipped")
	t.expect(back["id"] == &"hat_straw" and typeof(back["id"]) == TYPE_STRING, "(fact) a StringName comes back as String, == still holds")
	var names: Array[StringName] = SaveCodec.names_from_json(SaveCodec.through_json(SaveCodec.names_to_json([&"a", &"b"])))
	t.expect(names == [&"a", &"b"] and typeof(names[0]) == TYPE_STRING_NAME, "StringName lists round trip through JSON")
	var counts := SaveCodec.int_counts({"a": 3.0, "b": 0.0, "c": -2.0, "d": "4"})
	t.expect(counts == {"a": 3, "d": 4} and SaveCodec.int_counts([]) == {}, "int_counts coerces to int and drops zero / negative entries (%s)" % str(counts))
	var r1 := RandomNumberGenerator.new()
	r1.seed = 987654321987
	for i in 7:
		r1.randf()
	var txt := JSON.stringify(SaveCodec.rng_to_json(r1))
	var expected: Array = []
	for i in 5:
		expected.append(r1.randi())
	var r2 := RandomNumberGenerator.new()
	SaveCodec.rng_from_json(r2, JSON.parse_string(txt))
	var got: Array = []
	for i in 5:
		got.append(r2.randi())
	t.expect(got == expected and typeof(SaveCodec.rng_to_json(r1)["state"]) == TYPE_STRING, "an RNG restored from its decimal strings continues the identical stream")
	var big := RandomNumberGenerator.new()
	big.seed = -4611686018427387905
	var r3 := RandomNumberGenerator.new()
	SaveCodec.rng_from_json(r3, JSON.parse_string(JSON.stringify(SaveCodec.rng_to_json(big))))
	t.expect(r3.seed == big.seed and r3.state == big.state, "seed and state beyond 2^53 survive as strings")
	t.expect(int(JSON.parse_string(JSON.stringify(9007199254740993))) != 9007199254740993, "(control) a JSON NUMBER above 2^53 loses precision")
	var fresh := RandomNumberGenerator.new()
	SaveCodec.rng_from_json(fresh, {})
	t.expect(fresh.seed != 0 or fresh.state != 0, "an empty rng section randomizes instead of failing")


