func _semantics() -> void:
	var t = _t
	# the runtime messages of the inline scripts below are engine warnings (the first matching rule counts a message)
	t.allow("LuaRuntime: res://x.lua:4 in u: unknown Lua function `nonexistent`")
	t.allow("LuaRuntime: res://x.lua:")
	t.allow("LuaRuntime: res://tests/where_")
	# unknown api functions and constructs are logged once and never raise
	var sid := "tests/fixtures/lua/semantics_inline"
	_lr._scripts[sid] = _lr.parse_lua_source("kind = \"quest\"\nid = \"u\"\nfunction u(context)\n  api.nonexistent(\"x\")\n  local n = 3 * 4\n  api.nonexistent(\"y\")\n  return { ok = true, n = n }\nend\n", "res://x.lua")
	var mark: int = t.log_mark()
	_lr._logged_once.clear()
	var r1: Variant = _lr._invoke_function(sid, "u", [{}])
	var logged_after_first: int = _lr._logged_once.size()
	var r2: Variant = _lr._invoke_function(sid, "u", [{}])
	t.check("unknown_identifiers_log_once", logged_after_first >= 1 and _lr._logged_once.size() == logged_after_first, "an unknown api function is logged once (%d messages after two calls), as an engine warning that names file, line and function" % _lr._logged_once.size())
	t.expect_clean_since(mark, "unknown api functions and unsupported constructs raise no engine error and no other warning")
	t.expect(t.allowed_count("LuaRuntime: res://x.lua:4 in u: unknown Lua function `nonexistent`") == 1, "the unknown function is ONE engine warning for two calls (%d)" % t.allowed_count("LuaRuntime: res://x.lua:4 in u: unknown Lua function `nonexistent`"))
	t.expect(typeof(r1) == TYPE_DICTIONARY and r1["ok"] == true and r2 == r1, "the function still returns its table")
	_lr._scripts.erase(sid)
	# a runtime message names the file, line and function, and each script reports its own mistake once (LUA-04)
	var where_src := "kind = \"quest\"\nid = \"w\"\n\nfunction w(context)\n  local x = 1\n  api.no_such_call(\"x\")\n  return x\nend\n"
	_lr._scripts["tests/where_a"] = _lr.parse_lua_source(where_src, "res://tests/where_a.lua")
	_lr._scripts["tests/where_b"] = _lr.parse_lua_source(where_src, "res://tests/where_b.lua")
	_lr.runtime_report.clear()
	_lr._logged_once.clear()
	_lr._invoke_function("tests/where_a", "w", [{}])
	_lr._invoke_function("tests/where_a", "w", [{}])
	_lr._invoke_function("tests/where_b", "w", [{}])
	var rows: Array = _lr.runtime_report.filter(func(r: Dictionary) -> bool: return str(r["message"]).begins_with("unknown Lua function `no_such_call`"))
	t.check("runtime_messages_name_their_place", rows.size() == 2 and rows[0]["path"] == "res://tests/where_a.lua" and int(rows[0]["line"]) == 6 and rows[0]["function"] == "w" and rows[1]["path"] == "res://tests/where_b.lua", "one message per script, with path, line 6 and the function: %s" % str(rows))
	_lr._scripts.erase("tests/where_a")
	_lr._scripts.erase("tests/where_b")
	# the bodies compiled at load (with the lint) and the ones compiled lazily (release) are the same statements, lines included
	var grammar: Array[Dictionary] = []
	var eager: Dictionary = LuaParser.parse_tokens(where_src, LuaTokens.tokenize(where_src), "", grammar)["functions"]["w"]
	t.expect(eager.has("ast") and eager["ast"] == LuaParser.compile_body(str(eager["body"]), int(eager["body_line"])) and grammar.is_empty(), "eager and lazy compilation agree, lines included: %s" % str(eager.get("ast", [])))
	# a statement outside the subset is skipped AND said at run time (it used to vanish without a word)
	_lr._scripts[sid] = _lr.parse_lua_source("kind = \"quest\"\nid = \"u\"\nfunction u(context)\n  context.seen = true\n  return { ok = true }\nend\n", "res://x.lua")
	_lr._logged_once.clear()
	var r3: Variant = _lr._invoke_function(sid, "u", [{}])
	var said: bool = _lr._logged_once.keys().any(func(m: String) -> bool: return m.begins_with("unsupported Lua statement (assignment to a field)"))
	t.check("unsupported_statement_logged", said and typeof(r3) == TYPE_DICTIONARY and r3["ok"] == true, "a field assignment is skipped and logged once: %s" % str(_lr._logged_once.keys()))
	_lr._scripts.erase(sid)
	# truthiness, comparisons and precedence are covered by the real-Lua cases of lua_probes (semantics.lua);
	# here the pieces that need the game: notification text through tr(), api.emit payload types
	var tr_locale := "da"
	var old_locale := TranslationServer.get_locale()
	var tr_obj := Translation.new()
	tr_obj.locale = tr_locale
	tr_obj.add_message("LUATEST_TITLE", "Oversat titel")
	TranslationServer.add_translation(tr_obj)
	TranslationServer.set_locale(tr_locale)
	_captured_notifs.clear()
	_lr.lua_notification("LUATEST_TITLE", "plain text stays")
	TranslationServer.set_locale(old_locale)
	TranslationServer.remove_translation(tr_obj)
	t.check("notification_through_tr", _captured_notifs.size() == 1 and _captured_notifs[0][0] == "Oversat titel" and _captured_notifs[0][1] == "plain text stays", "lua_notification runs title and message through tr(): %s" % str(_captured_notifs))
	_captured_emits.clear()
	_lr.lua_emit("test_event", {"amount": 3, "who": "x"})
	t.expect(_captured_emits.size() == 1 and _captured_emits[0][0] == "test_event" and _captured_emits[0][1] == {"amount": 3, "who": "x"}, "lua_emit carries the payload through EventBus.lua_event")
	# a function that returns early keeps its effects before the return; a missing function is nil, a missing script {}
	t.expect(_lr._invoke_function("nope/nothing", "f", []) == null and _lr.get_dialogue("no_such_dialogue", {}).is_empty(), "an unknown script or function answers null / {}")
	# bare identifiers read world flags (including after the flags came through JSON)
	(_gm.world_flags as Dictionary).clear()
	_gm.set_flag(&"fx_seen", true)
	var parsed: Dictionary = _lr.parse_lua_source("kind = \"quest\"\nid = \"b\"\nfunction b(context)\n  return fx_seen and not fx_gone\nend\n", "res://x.lua")
	_lr._scripts["tests/inline_b"] = parsed
	t.expect(_lr._invoke_function("tests/inline_b", "b", [{}]) == true, "a bare identifier is the world flag of that name")
	_gm.set_flag(&"fx_gone", 1.0)
	t.expect(_lr._invoke_function("tests/inline_b", "b", [{}]) == false, "...also a numeric (float) flag, and 1.0 is true")
	_lr._scripts.erase("tests/inline_b")
	(_gm.world_flags as Dictionary).clear()


# ---------------------------------------------------------------------------------------------------- hot reload

## F9 (reload_scripts) tells the consumers that copied Lua data (LUA-03): EventBus.lua_reloaded once per reload; QuestManager
## drops the definition of a quest whose file is gone (registered-by-code definitions stay); AnimalHusbandry re-reads its
## config; ShopSystem forgets today's rotation rows.
func _hot_reload_consumers() -> void:
	var t = _t
	var qm: Node = t.autoload("QuestManager")
	var husbandry: Node = t.autoload("AnimalHusbandry")
	var shop: Node = t.autoload("ShopSystem")
	if qm == null or husbandry == null or shop == null:
		t.skip("hot reload consumers: QuestManager / AnimalHusbandry / ShopSystem missing")
		return
	var reloads := [0]
	var count := func() -> void: reloads[0] += 1
	_bus.lua_reloaded.connect(count)
	_lr.load_file(FIX + "semantics.lua")                        # kind quest, id "semantics": a file-based definition
	qm.register_quest_from_lua({"id": "zz_lua03_by_code", "objectives": [], "rewards": {}, "meta": {}})
	var registered: bool = qm.quest_defs.has(&"semantics") and qm.quest_defs.has(&"zz_lua03_by_code")
	_gm.set_config_override("husbandry", {"species": {"zz_lua03_species": {"name_key": "X", "product_interval": "daily"}}})
	shop._rotation_cache["seed_shop"] = {"day": -1, "rows": []}
	_lr.reload_scripts()
	var pruned: bool = not qm.quest_defs.has(&"semantics") and qm.quest_defs.has(&"zz_lua03_by_code") and qm.quest_defs.has(&"lost_cat")
	var reread: bool = (husbandry.species_data as Dictionary).has("zz_lua03_species")
	var rotation_dropped: bool = not (shop._rotation_cache as Dictionary).has("seed_shop")
	_gm.clear_config_overrides()
	_lr.reload_scripts()
	var restored: bool = not (husbandry.species_data as Dictionary).has("zz_lua03_species") and (husbandry.species_data as Dictionary).has("chicken")
	qm.quest_defs.erase(&"zz_lua03_by_code")
	_bus.lua_reloaded.disconnect(count)
	t.check("hot_reload_refreshes_consumers", registered and pruned and reread and rotation_dropped and restored and reloads[0] == 2, "two reloads, two lua_reloaded (%d); a removed quest file's definition is dropped, a code-registered one kept (%s); husbandry re-read (%s, back to the file %s); the rotation cache dropped (%s)" % [reloads[0], pruned, reread, restored, rotation_dropped])


