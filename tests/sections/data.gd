## Real Lua as an independent gate (LUA-01): the subset is a subset of Lua 5.4, so `luac -p` must accept every file under
## res://lua. The playtest workflow installs lua5.4; a developer machine without it skips (brew install lua).
func _real_lua_syntax() -> void:
	var t = _t
	var luac := ""
	for exe in ["luac5.4", "luac"]:
		if int(t.run_tool(exe, PackedStringArray(["-v"]))["code"]) == 0:
			luac = exe
			break
	if luac == "":
		if OS.get_environment("CI") != "":
			t.fail("lua_real_syntax: no luac5.4 / luac on the PATH of this CI runner (the playtest workflow installs lua5.4)")
		else:
			t.skip("lua_real_syntax: no luac5.4 / luac on the PATH (brew install lua)")
		return
	var args := PackedStringArray(["-p"])
	for sid in _lr.get_all_script_ids():
		args.append(ProjectSettings.globalize_path(str(_lr._scripts[sid]["source_path"])))
	var res: Dictionary = t.run_tool(luac, args)
	t.check("lua_real_syntax", int(res["code"]) == 0 and args.size() > 200, "%s -p accepts all %d files under res://lua: %s" % [luac, args.size() - 1, str(res["output"]).strip_edges().left(300)])
	# negative control: real Lua refuses the review's `!=` case
	var bad := "user://lua_real_syntax_probe.lua"
	var f := FileAccess.open(bad, FileAccess.WRITE)
	f.store_string("function f(context)\n  if context.weekday != 2 then\n    return 1\n  end\nend\n")
	f.close()
	var neg: Dictionary = t.run_tool(luac, PackedStringArray(["-p", ProjectSettings.globalize_path(bad)]))
	DirAccess.remove_absolute(ProjectSettings.globalize_path(bad))
	t.expect(int(neg["code"]) != 0, "(control) %s -p refuses `!=`: exit %d" % [luac, int(neg["code"])])


# ---------------------------------------------------------------------------------------------------- the probes

func _probes() -> void:
	var t = _t
	# the probes outside the subset make the interpreter say what it skipped: one engine warning each (QUAL-08), all of them
	# naming a fixture file
	t.allow("LuaRuntime: res://tests/fixtures/lua/")
	var raw := FileAccess.get_file_as_string(FIX + "probe_expected.json")
	var doc: Variant = JSON.parse_string(raw)
	t.check("probe_fixture_loaded", typeof(doc) == TYPE_DICTIONARY and (doc as Dictionary).has("cases") and str(doc.get("generator", "")).begins_with("Lua 5.4"), "probe_expected.json holds %d cases generated with %s" % [(doc as Dictionary).get("cases", []).size() if typeof(doc) == TYPE_DICTIONARY else 0, str((doc as Dictionary).get("generator", "?")) if typeof(doc) == TYPE_DICTIONARY else "?"])
	if typeof(doc) != TYPE_DICTIONARY:
		return
	var counts := {"exact": 0, "best_effort": 0, "flagged": 0}
	var failed := 0
	var files := {}
	var mark: int = t.log_mark()
	for c in doc["cases"]:
		var ok := _run_case(c)
		counts[str(c["mode"])] = int(counts.get(str(c["mode"]), 0)) + 1
		files[str(c["probe"])] = true
		if not ok:
			failed += 1
	t.expect_clean_since(mark, "replaying every probe (also the ones outside the subset) raises no engine error and no warning but the runtime messages of the fixtures")
	t.check("lua_probes", failed == 0, "%d cases over %d files: %d exact, %d best effort, %d flagged-only; %d failed" % [(doc["cases"] as Array).size(), files.size(), counts["exact"], counts["best_effort"], counts["flagged"], failed])


## Replays one case of probe_expected.json. Returns false (and records a failure) on any deviation.
func _run_case(c: Dictionary) -> bool:
	var t = _t
	var probe := str(c["probe"])
	var path := FIX + probe + ".lua"
	var source := FileAccess.get_file_as_string(path)
	var label := "%s.%s %s" % [probe, c["fn"], c["label"]]
	# 1. the lint: exact files are clean, the others report every rule the case names
	var rules := _rules_of(_lr.lint_source(source, path))
	var ok := true
	if str(c["mode"]) == "exact":
		if not rules.is_empty():
			ok = false
			t.fail("probe %s should lint clean, got %s" % [label, str(rules)])
	for want in c["lint"]:
		if not (str(want) in rules):
			ok = false
			t.fail("probe %s: the lint should report %s, got %s" % [label, want, str(rules)])
	if str(c["mode"]) == "flagged":
		# outside the subset: only run it to prove nothing raises (the caller checks the log)
		_execute(source, path, c)
		return ok
	# 2. the result and the side effects against real Lua 5.4
	var got := _execute(source, path, c)
	var ref: Dictionary = c["ref"]
	var want_result: Variant = ref.get("result", null)
	if not _same(_norm(got["result"]), _norm(want_result)):
		ok = false
		t.fail("probe %s: result %s, real Lua says %s" % [label, JSON.stringify(got["result"]), JSON.stringify(want_result)])
	var want_fx: Dictionary = ref["effects"]
	var got_fx: Dictionary = got["effects"]
	for key in ["flags", "gold", "notifs", "emits"]:
		if not _same(_norm(got_fx[key]), _norm(want_fx.get(key, null))):
			ok = false
			t.fail("probe %s: %s %s, real Lua says %s" % [label, key, JSON.stringify(got_fx[key]), JSON.stringify(want_fx.get(key, null))])
	if ok:
		t.expect(true, "probe %s" % label)
	return ok


## Runs function c.fn of the probe source and reports {result, effects{flags, gold, notifs, emits}}.
func _execute(source: String, path: String, c: Dictionary) -> Dictionary:
	var sid := "tests/fixtures/lua/%s" % str(c["probe"])
	_lr._scripts[sid] = _lr.parse_lua_source(source, path)
	(_gm.world_flags as Dictionary).clear()
	for k in (c["flags"] if typeof(c["flags"]) == TYPE_DICTIONARY else {}):
		_gm.world_flags[StringName(k)] = c["flags"][k]
	var flags_before: Dictionary = (_gm.world_flags as Dictionary).duplicate()
	var gold_before: int = int(_eco.gold) if _eco != null else 0
	_captured_notifs.clear()
	_captured_emits.clear()
	var args: Array = []
	for a in c["args"]:
		args.append({} if (typeof(a) == TYPE_ARRAY and (a as Array).is_empty()) else a)
	var result: Variant = _lr._invoke_function(sid, str(c["fn"]), args)
	var flags_changed := {}
	for k in _gm.world_flags:
		if not flags_before.has(k) or flags_before[k] != _gm.world_flags[k]:
			flags_changed[str(k)] = _gm.world_flags[k]
	var effects := {
		"flags": flags_changed,
		"gold": (int(_eco.gold) - gold_before) if _eco != null else 0,
		"notifs": _captured_notifs.duplicate(true),
		"emits": _captured_emits.duplicate(true),
	}
	_lr._scripts.erase(sid)
	return {"result": result, "effects": effects}


func _on_notification(title: String, message: String, icon: String) -> void:
	if icon == "lua":
		_captured_notifs.append([title, message])


func _on_lua_event(event_name: StringName, payload: Dictionary) -> void:
	_captured_emits.append([str(event_name), payload])


## Comparable form: numbers as float, names as String, empty containers as [], null entries dropped, keys sorted.
func _norm(v: Variant) -> Variant:
	match typeof(v):
		TYPE_INT, TYPE_FLOAT:
			return float(v)
		TYPE_STRING, TYPE_STRING_NAME:
			return str(v)
		TYPE_DICTIONARY:
			var d: Dictionary = v
			if d.is_empty():
				return []
			var out := {}
			for k in d:
				if d[k] != null:
					out[str(k)] = _norm(d[k])
			if out.is_empty():
				return []
			return out
		TYPE_ARRAY:
			var arr: Array = []
			for x in v:
				arr.append(_norm(x))
			return arr
	return v


## == that never raises: values of different types are simply different (Array == Dictionary is an engine error)
func _same(a: Variant, b: Variant) -> bool:
	return typeof(a) == typeof(b) and a == b


func _rules_of(findings: Array) -> Array[String]:
	var seen := {}
	for f in findings:
		seen[str((f as Dictionary).get("rule", ""))] = true
	var out: Array[String] = []
	for k in seen:
		out.append(str(k))
	out.sort()
	return out


# ---------------------------------------------------------------------------------------------------- flag identifiers

## The content pattern `context.x or x or default` with its 29 branch combinations (RV-P2a). Each combination is driven
## three ways: only the world flag, only the context (also with StringName keys) and the flag after a JSON round trip (floats).
func _flag_identifiers() -> void:
	var t = _t
	var sid: String = _lr.load_file(FIX + "flag_identifiers.lua")
	t.expect(sid == "tests/fixtures/lua/flag_identifiers" and _lr._dialogue_modules.has("flag_identifiers"), "the inline fixture registers as dialogue flag_identifiers")
	var combos: Array = []                                      # [flags, expected branch]
	for n in range(2, 11):
		combos.append([{"home_upgrade_done": n}, "done_%d" % n])
	for n in range(2, 11):
		combos.append([{"home_building": n}, "building_%d" % n])
	for n in range(1, 11):
		combos.append([{"home_tier": n}, "tier_%d" % n])
	combos.append([{"home_tier": 11}, "default"])
	var seen_branches := {}
	var failed := 0
	var mark: int = t.log_mark()
	for combo in combos:
		var flags: Dictionary = combo[0]
		var want: String = combo[1]
		seen_branches[want] = true
		var from_flags := _flag_branch(flags, {}, false)
		var from_context := _flag_branch({}, flags, false)
		var from_context_names := _flag_branch({}, flags, true)
		var from_json := _flag_branch(SaveCodec.through_json(flags), {}, false)
		for pair in [["world flag", from_flags], ["context", from_context], ["context with StringName keys", from_context_names], ["flag after a JSON round trip", from_json]]:
			if str(pair[1]) != want:
				failed += 1
				t.fail("flag identifiers %s via %s: got %s, want %s" % [flags, pair[0], pair[1], want])
	t.check("content_flag_identifiers", failed == 0 and seen_branches.size() == 29, "%d branch combinations x 4 sources (world flag, context, context with StringName keys, JSON float flag); %d wrong" % [seen_branches.size(), failed])
	# defaults, precedence, mixed sources, unset flags without an engine error
	t.expect(_flag_branch({}, {}, false) == "tier_1", "nothing set: the defaults (tier 1, no building, nothing done) give tier_1")
	t.expect(_flag_branch({"home_upgrade_done": 3, "home_building": 4, "home_tier": 2}, {}, false) == "done_3", "precedence: celebration (done) before construction before idle")
	t.expect(_flag_branch({"home_building": 5, "home_tier": 2}, {}, false) == "building_5", "precedence: construction before idle")
	t.expect(_flag_branch({"home_tier": 4}, {"home_tier": 7}, false) == "tier_7", "the context wins over the world flag (`context.x or x`)")
	t.expect(_flag_branch({"home_tier": false}, {}, false) == "tier_1", "a flag that is false counts as unset (`or` falls through to the default)")
	t.expect(_flag_branch({"home_tier": 0}, {}, false) == "default", "0 is a number (true in Lua): tier 0 matches no branch and falls through")
	t.expect_clean_since(mark, "an unset flag compared with a number raises no engine error")
	var d: Dictionary = _lr.get_dialogue("flag_identifiers", {"home_upgrade_done": 4})
	t.expect(d["lines"][0]["id"] == "t04_done" and d["choices"].size() == 2 and d["choices"][0]["shop_id"] == "builder_yard", "nested arrays of tables inside the returned table are intact")
	(_gm.world_flags as Dictionary).clear()


func _flag_branch(flags: Dictionary, context: Dictionary, string_name_keys: bool) -> String:
	(_gm.world_flags as Dictionary).clear()
	for k in flags:
		_gm.set_flag(StringName(k), flags[k])
	var ctx := {}
	for k in context:
		ctx[StringName(k) if string_name_keys else str(k)] = context[k]
	var d: Dictionary = _lr.get_dialogue("flag_identifiers", ctx)
	return str(d.get("branch", "<none>"))


