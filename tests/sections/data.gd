	var missing: Array[String] = []
	var documented: Array[String] = []
	for k in PLAYER_KEYS:
		documented.append("player.%s" % k)
	for k in ["harvest_yield", "fertilizer_bonus_yield", "auto_water_days"]:
		documented.append("farm.%s" % k)
	for crop in CROPS:
		for k in ["stages", "days_per_stage", "seasons", "sell_price"]:
			documented.append("crops.%s.%s" % [crop, k])
	for k in ["starting_gold", "sell_price_ratio", "tax_per_day", "home_cost_scale"]:
		documented.append("economy.%s" % k)
	for k in ["dark_forest_unlock_day", "ore_respawn_days", "rare_gem_chance", "enemy_damage_base", "loot_table_size", "oil_empty_hurt_interval"]:
		documented.append("adventure.%s" % k)
	for k in ["minutes_per_real_second", "day_start_hour", "day_end_hour", "days_per_season", "seasons", "first_weekday", "night_start_hour", "night_end_hour", "auto_save_minutes"]:
		documented.append("time.%s" % k)
	for season in ["foraar", "sommer", "efteraar", "vinter"]:
		documented.append("time.weather_chances.%s" % season)
	for k in ["notification_duration_seconds", "dialogue_chars_per_second"]:
		documented.append("ui.%s" % k)
	for race in RACES:
		for k in PERK_KEYS:
			documented.append("race_perks.%s.%s" % [race, k])
	for k in COMBAT_KEYS:
		documented.append("combat.%s" % k)
	documented.append_array(["rarity_tiers.order", "rarity_tiers.legendary.ui.icon_rim", "perk_caps.speed", "perk_caps.energy", "perk_caps.luck", "perk_caps.discount", "perk_caps.energy_total", "perk_caps.discount_total", "npcs.mayor_lyra.visual", "npc_vocab.areas", "npc_vocab.roles", "npc_vocab.schedules", "npc_vocab.ages", "species_perks.animal_monkey.climb_speed_mult"])
	for path in documented:
		if _lr.get_config(path, null) == null:
			missing.append(path)
	_t.check("config_documented_keys", missing.is_empty(), "%d documented keys, missing: %s" % [documented.size(), str(missing)])
	t.expect(_lr.get_config("player.nonexistent", 7) == 7 and _lr.get_config("crops.carrot.stages.deep", "d") == "d", "get_config answers the default for an unknown path")
	t.expect(_lr.get_config("time.seasons.1", "") == "sommer", "get_config indexes arrays (time.seasons.1)")
	# the numbers of plan 3.13 (the 3D spike values x 1/0.6, interaction range 45 by D20)
	var want := {
		"player.walk_speed": 285, "player.run_speed": 450, "player.accel": 2500, "player.decel": 3300, "player.hop_impulse": 620,
		"player.gravity": 1750, "player.flight_altitude": 150, "player.flight_climb": 225, "player.body_rx": 25, "player.interaction_range": 45,
		"player.max_stamina": 100, "player.stamina_regen_per_second": 12, "player.run_cost_per_second": 15,
		"combat.swing_radius": 197, "combat.dodge_distance": 317, "combat.light_radius": 550, "combat.knockback": 433,
		"economy.starting_gold": 500, "adventure.dark_forest_unlock_day": 1, "adventure.oil_empty_hurt_interval": 12,
	}
	var wrong: Array[String] = []
	for k in want:
		if float(_lr.get_config(k, -1)) != float(want[k]):
			wrong.append("%s=%s want %s" % [k, _lr.get_config(k, null), want[k]])
	t.check("config_plan_numbers", wrong.is_empty(), "section 3.13 numbers: %s" % str(wrong))
	var spike := {"player.walk_speed": 170.0, "player.run_speed": 270.0, "player.accel": 1500.0, "player.decel": 2000.0, "player.hop_impulse": 370.0, "player.gravity": 1050.0,
		"player.flight_altitude": 90.0, "player.flight_climb": 135.0, "player.body_rx": 15.0, "combat.swing_radius": 118.0, "combat.dodge_distance": 190.0, "combat.light_radius": 330.0, "combat.knockback": 260.0}
	var drift: Array[String] = []
	for k in spike:
		var ratio: float = float(_lr.get_config(k, 0)) / (float(spike[k]) / 0.6)
		if absf(ratio - 1.0) > 0.02:
			drift.append("%s %.3f" % [k, ratio])
	t.check("config_units_are_spike_over_0_6", drift.is_empty(), "every distance and speed is the spike value x 1/0.6 within 2%%: %s" % str(drift))
	t.expect(is_equal_approx(float(_lr.get_config("economy.home_cost_scale", 0.0)), 1.0), "economy.home_cost_scale defaults to 1.0 (CD5)")
	# the tables of two config files never collide
	var owners := {}
	var dup := false
	for sid in ["config/game_balance", "config/race_perks", "config/rarity", "config/npcs", "config/species_perks"]:
		if not _lr.has_script(sid):
			t.fail("config file %s is not loaded" % sid)
			continue
		var cfg: Dictionary = (_lr._scripts[sid] as Dictionary).get("config", {})
		for key in cfg:
			if owners.has(key):
				dup = true
			owners[key] = sid
	t.expect(not dup, "game_balance / race_perks / rarity / npcs / species_perks define disjoint top-level keys (%s)" % str(owners.keys()))
	t.expect(_lr.lint_report.filter(func(f: Dictionary) -> bool: return str(f["rule"]) == "duplicate_key").is_empty(), "no config key is defined by two files")


func _numbers_positive() -> void:
	var bad: Array[String] = []
	var counter := {"n": 0}
	var must_be_positive := PLAYER_KEYS.map(func(k: String) -> String: return "player.%s" % k)
	for sid in ["config/game_balance", "config/race_perks"]:
		var cfg: Dictionary = (_lr._scripts[sid] as Dictionary).get("config", {})
		for top in cfg:
			_walk_numbers("%s" % top, cfg[top], bad, counter)
	for path in must_be_positive:
		if float(_lr.get_config(path, 0.0)) <= 0.0:
			bad.append("%s must be > 0" % path)
	for crop in CROPS:
		for k in ["stages", "days_per_stage", "sell_price"]:
			if float(_lr.get_config("crops.%s.%s" % [crop, k], 0.0)) <= 0.0:
				bad.append("crops.%s.%s must be > 0" % [crop, k])
	_t.check("numbers_positive", bad.is_empty() and int(counter["n"]) > 60, "%d numbers inspected, none negative / NaN, the speeds, prices and durations > 0 %s" % [int(counter["n"]), str(bad)])


## every numeric leaf must be finite and >= 0 (booleans and strings are not numbers)
func _walk_numbers(path: String, v: Variant, bad: Array[String], counter: Dictionary) -> void:
	match typeof(v):
		TYPE_INT, TYPE_FLOAT:
			counter["n"] = int(counter["n"]) + 1
			var f := float(v)
			if is_nan(f) or is_inf(f) or f < 0.0:
				bad.append("%s = %s" % [path, str(v)])
		TYPE_DICTIONARY:
			for k in v:
				_walk_numbers("%s.%s" % [path, k], v[k], bad, counter)
		TYPE_ARRAY:
			for i in (v as Array).size():
				_walk_numbers("%s.%d" % [path, i], v[i], bad, counter)


# ---------------------------------------------------------------------------------------------------- roster

## The closed vocabularies the roster rows are validated against: lua/config/npcs.lua `npc_vocab` (areas, roles, schedules, ages). The DATA brings
## them, so a data-only citizen with a new role only adds the word there. AREA_IDS / ROLES / SCHEDULES above are the CONTRACT FLOOR: the data lists
## may grow, they may never lose a word of the floor (roster_vocabulary_floor).
func _vocab() -> Dictionary:
	var out := {}
	for k in ["areas", "roles", "schedules", "ages"]:
		out[k] = LuaData.strings(_lr.get_config("npc_vocab.%s" % k, []))
	return out


## Where the sprite chain of a row ends: the row's `fallback`, followed through lua/config/characters.lua `fallbacks` and the other rows'
## own visual -> fallback pairs, at most four hops, until a PACK character is reached ("" when it never is).
func _chain_end(fallback: String, all_visuals: Dictionary) -> String:
	var table: Dictionary = LuaData.dict(_lr.get_config("characters.fallbacks", {}))
	var cur := fallback
	var hops := 0
	while cur != "" and not (cur in PACK_CHARACTERS) and hops < 4:
		cur = str(table.get(cur, all_visuals.get(cur, "")))
		hops += 1
	return cur


## Every problem of ONE roster row ([] = valid): the field rules of the contract against the data's own vocabularies. Used for the real rows, for the
## synthetic data-only citizen and for its negative controls.
func _row_problems(id: String, n: Dictionary, vocab: Dictionary, all_visuals: Dictionary) -> Array[String]:
	var problems: Array[String] = []
	if str(n.get("id", "")) != id:
		problems.append("id not filled in")
	if str(n.get("name_key", "")) != "NPC_%s" % id.to_upper():
		problems.append("name_key %s" % n.get("name_key"))
	var voice: Dictionary = n.get("voice", {})
	if not (float(voice.get("pitch", 0.0)) >= 0.5 and float(voice.get("pitch", 0.0)) <= 2.0 and float(voice.get("rate", 0.0)) >= 0.5 and float(voice.get("rate", 0.0)) <= 2.0):
		problems.append("voice %s" % str(voice))
	if not (str(n.get("home_area", "")) in vocab["areas"]) or str(n.get("home_area", "")).begins_with("moerkeskoven_f"):
		problems.append("home_area %s" % n.get("home_area"))
	if not (str(n.get("role", "")) in vocab["roles"]):
		problems.append("role %s" % n.get("role"))
	if not (str(n.get("facing", "")) in DIR8):
		problems.append("facing %s" % n.get("facing"))
	if not (str(n.get("schedule", "")) in vocab["schedules"]):
		problems.append("schedule %s" % n.get("schedule"))
	var wander: Dictionary = n.get("wander", {})
	if not (wander.has("radius") and wander.has("speed") and float(wander["radius"]) >= 0.0 and float(wander["speed"]) >= 0.0 and float(wander["speed"]) <= 1.0):
		problems.append("wander %s" % str(wander))
	if typeof(n.get("friendship", null)) != TYPE_BOOL:
		problems.append("friendship must be true or false")
	if str(n.get("dialogue", "")) == "":
		problems.append("no dialogue id")
	if n.has("shop_id"):
		var shop: Dictionary = _lr.get_shop(str(n["shop_id"]))
		if not (str(n["shop_id"]) in SHOP_IDS) and shop.is_empty():
			problems.append("shop_id %s is not a shop of the contract" % n["shop_id"])
		if not shop.is_empty() and str(shop.get("keeper", "")) != id:
			problems.append("shop %s names %s as its keeper, not this npc" % [n["shop_id"], shop.get("keeper", "")])
	if n.has("quests_offered") and typeof(n["quests_offered"]) != TYPE_ARRAY:
		problems.append("quests_offered must be a list")
	if n.has("portrait") and str(n["portrait"]) == "":
		problems.append("an empty portrait override must be omitted")
	if n.has("routine") and typeof(n["routine"]) != TYPE_BOOL:
		problems.append("routine must be true or false")
	if n.has("age") and not (str(n["age"]) in vocab["ages"]):
		problems.append("age %s" % n["age"])
	if n.has("family") and str(n["family"]) == "":
		problems.append("an empty family must be omitted")
	if n.has("scale") and not (float(n["scale"]) > 0.0 and float(n["scale"]) <= 2.0):
		problems.append("scale %s" % n["scale"])
	# the sprite: a real id plus a fallback chain that ends in one of the 12 pack characters; `visual == fallback` is fine only for a pack character
	var visual := str(n.get("visual", ""))
	var fallback := str(n.get("fallback", ""))
	if visual == "" or fallback == "" or (visual == fallback and not (visual in PACK_CHARACTERS)):
		problems.append("visual %s / fallback %s" % [visual, fallback])
	if not (_chain_end(fallback, all_visuals) in PACK_CHARACTERS):
		problems.append("the fallback chain of %s does not end at a pack character" % visual)
	return problems


func _roster() -> void:
	var t = _t
	var npcs: Dictionary = _lr.get_npcs()
	var vocab := _vocab()
	var expected: Array = ROSTER_BASE + ROSTER_NEW + ROSTER_FEATURE
	var ids_ok := true
	for id in expected:
		if not npcs.has(id):
			ids_ok = false
			t.fail("npcs.lua has no %s" % id)
	# every REQUIRED id exists (the 15 + the 7 of the v2 cast); the number of rows is never pinned: a data-only citizen is welcome (RT20)
	t.check("roster_ids", ids_ok, "the %d required ids exist: the 8 stable ids, the 4 + 7 new ids and the 3 feature fairies (the roster has %d rows, no size pin)" % [expected.size(), npcs.size()])
	var floor_ok := true
	for pair in [["areas", AREA_IDS], ["roles", ROLES], ["schedules", SCHEDULES]]:
		for word in pair[1]:
			if not (word in vocab[pair[0]]):
				floor_ok = false
				t.fail("npc_vocab.%s lost the word %s" % [pair[0], word])
	t.check("roster_vocabulary_floor", floor_ok, "npc_vocab of lua/config/npcs.lua (areas %s, %d roles, schedules %s, ages %s) holds every word of the contract floor" % [str(vocab["areas"]), (vocab["roles"] as Array).size(), str(vocab["schedules"]), str(vocab["ages"])])
	var fields_ok := true
	var name_keys := {}
	var all_visuals := {}
	for id in npcs:
		all_visuals[str((npcs[id] as Dictionary).get("visual", ""))] = str((npcs[id] as Dictionary).get("fallback", ""))
	for id in npcs:
		var n: Dictionary = npcs[id]
		var problems: Array[String] = _row_problems(str(id), n, vocab, all_visuals)
		if name_keys.has(n.get("name_key")):
			problems.append("name_key used twice")
		name_keys[n.get("name_key")] = true
		if not problems.is_empty():
			fields_ok = false
			t.fail("npc %s: %s" % [id, "; ".join(problems)])
	t.check("roster_fields", fields_ok, "every npc row (%d) has name_key NPC_<ID>, visual + fallback chain, voice, home_area, role, dialogue, wander, facing, schedule, friendship; areas, roles, schedules and ages come from npc_vocab" % npcs.size())
	t.expect(fields_ok, "every visual resolves to real art or to a chain that ends at a pack character (the art check is P21's / V2's art_characters section)")
	# the dialogue / shop / quest ids: contract strictly, existence as soon as the owning package landed (a pending target is a SKIP naming the package)
	var skipped: Array[String] = []
	for id in npcs:
		var n: Dictionary = npcs[id]
		var dlg := str(n.get("dialogue", ""))
		if _lr._dialogue_modules.has(dlg):
			t.expect(true, "dialogue %s of %s exists" % [dlg, id])
		elif str(id) in ROSTER_CITIZENS:
			pass     # the eight citizens of the towns track have no dialogue file by design (DT16: the engine passes an empty module)
		else:
			skipped.append("dialogue:%s (%s)" % [dlg, PENDING_DIALOGUE.get(str(id), "P14")])
		if n.has("shop_id"):
			if not _lr.get_shop(str(n["shop_id"])).is_empty():
				t.expect(str(_lr.get_shop(str(n["shop_id"])).get("keeper", id)) == str(id), "shop %s exists and its keeper is %s" % [n["shop_id"], id])
			else:
				skipped.append("shop:%s" % n["shop_id"])
		for q in (n.get("quests_offered", []) as Array):
			if _lr._quest_modules.has(str(q)):
				continue
			if str(q) in FEATURE_QUESTS:
				skipped.append("quest:%s (F1)" % q)
			elif PENDING_QUESTS.has(str(q)):
				skipped.append("quest:%s (%s)" % [q, PENDING_QUESTS[str(q)]])
			else:
				t.fail("npc %s offers quest %s which does not exist" % [id, q])
	if not skipped.is_empty():
		t.skip("roster targets that land with later packages: %s" % ", ".join(skipped))
	# nothing in the repo may name the quests of a NPC twice, a quest has one giver
	var givers := {}
	var twice := false
	for id in npcs:
		for q in (npcs[id].get("quests_offered", []) as Array):
			if givers.has(q):
				twice = true
			givers[q] = id
	t.expect(not twice, "a quest is offered by exactly one npc")
	t.expect(str((npcs["cat_morfar_mis"] as Dictionary).get("home_area", "")) == "hyggebyen" and not bool(npcs["cat_morfar_mis"]["friendship"]), "Morfar Mis lives in Hyggebyen and is a quest NPC without hearts")
	t.expect(not (npcs["penguin_postman"] as Dictionary).has("quests_offered"), "the penguin postman is ambient: no quest of his own (the postman with quests is Pip)")
	t.expect(_lr.get_npc("mayor_lyra").get("visual") == "fairy_mayor" and _lr.get_npc("nobody").is_empty(), "get_npc(id) answers the roster entry, {} for an unknown id")
	# addendum amendment 4: the three feature NPCs and the quest offers
	var b: Dictionary = npcs.get("fairy_builder", {})
	var f: Dictionary = npcs.get("fairy_furnisher", {})
	var tl: Dictionary = npcs.get("fairy_tailor", {})
	var feature_ok: bool = (
		b.get("visual") == "fairy_builder" and b.get("fallback") == "fairy_shopkeeper" and b.get("home_area") == "hyggebyen" and b.get("shop_id") == "builder_yard" and b.get("dialogue") == "fairy_builder"
		and f.get("shop_id") == "furniture_shop" and f.get("dialogue") == "fairy_furnisher" and f.get("name_key") == "NPC_FAIRY_FURNISHER"
		and tl.get("shop_id") == "tailor_shop" and tl.get("dialogue") == "fairy_tailor" and tl.get("name_key") == "NPC_FAIRY_TAILOR"
		and b.get("name_key") == "NPC_FAIRY_BUILDER"
	)
	var offers_ok: bool = (
		"snurresvampen" in (npcs["guard_oak"].get("quests_offered", []) as Array)
		and "bogtraeet" in (npcs["fairy_wizard"].get("quests_offered", []) as Array)
		and "moonstone_crown" in (npcs["fairy_king"].get("quests_offered", []) as Array)
		and "slotsdroemmen" in (npcs["fairy_king"].get("quests_offered", []) as Array)
	)
	var hearts_ok := true
	for id in expected:
		if id != "cat_morfar_mis" and npcs[id].get("friendship") != true:
			hearts_ok = false
	t.check("roster_has_feature_npcs", feature_ok and offers_ok and hearts_ok, "builder / furnisher / tailor with shops, voices and dialogue ids; guard_oak, fairy_wizard, fairy_king offer the four gating quests; friendship = true wherever hearts are reachable")
	t.expect(feature_ok and str(b.get("home_area")) == "hyggebyen" and str(f.get("home_area")) == "hyggebyen" and str(tl.get("home_area")) == "hyggebyen", "the feature fairies live in Hyggebyen")
	# the v2 cast and the towns citizens (V1-cast-data, RT20): 30 rows, every one valid as DATA, routine = true on all of them
	_roster_30(npcs, vocab, all_visuals)
	_roster_data_only_citizen(npcs, vocab, all_visuals)


## data.roster_30_rows_valid: the 15 + 7 + 8 citizens all exist, every row is valid as data (the same rules as roster_fields) and carries
## `routine = true` (the switch of the towns track) and an `age`; the eight new citizens have hearts. The count of rows is never asserted.
func _roster_30(npcs: Dictionary, vocab: Dictionary, all_visuals: Dictionary) -> void:
	var t = _t
	var thirty: Array = ROSTER_BASE + ROSTER_NEW + ROSTER_FEATURE + ROSTER_CITIZENS
	var problems: Array[String] = []
	for id in thirty:
		if not npcs.has(id):
			problems.append("%s: no row" % id)
			continue
		var n: Dictionary = npcs[id]
		for p in _row_problems(str(id), n, vocab, all_visuals):
			problems.append("%s: %s" % [id, p])
		if n.get("routine") != true:
			problems.append("%s: routine is not true" % id)
		if not n.has("age"):
			problems.append("%s: no age" % id)
		if id in ROSTER_CITIZENS and n.get("friendship") != true:
			problems.append("%s: friendship must be true" % id)
	t.check("roster_30_rows_valid", thirty.size() == 30 and problems.is_empty(), "%d citizens (15 + 7 + 8): every row valid as data, routine = true and an age on each, friendship = true on the eight new ones %s" % [thirty.size(), str(problems.slice(0, 4))])


## data.roster_accepts_data_only_citizen: a citizen that exists ONLY as a row (a new id, perhaps a new role) is green without any edit of this
## file, and the same validator still refuses every kind of broken row (negative controls). The pins read ids and fields, never the count.
func _roster_data_only_citizen(npcs: Dictionary, vocab: Dictionary, all_visuals: Dictionary) -> void:
	var t = _t
	var row := {
		"id": "zz_data_only_florist", "name_key": "NPC_ZZ_DATA_ONLY_FLORIST", "visual": "frog", "fallback": "frog", "voice": {"pitch": 1.0, "rate": 1.0},
		"home_area": "traetoppen", "role": "florist", "dialogue": "zz_data_only_florist", "wander": {"radius": 1, "speed": 0.3}, "facing": "S",
		"schedule": "sleep", "friendship": true, "routine": true, "age": "adult",
	}
	var wider: Dictionary = vocab.duplicate(true)
	(wider["roles"] as Array).append("florist")
	var without_word: Array[String] = _row_problems("zz_data_only_florist", row, vocab, all_visuals)
	var with_word: Array[String] = _row_problems("zz_data_only_florist", row, wider, all_visuals)
	var with_row: Dictionary = npcs.duplicate()
	with_row["zz_data_only_florist"] = row
	var required_still: bool = (ROSTER_BASE + ROSTER_NEW + ROSTER_FEATURE + ROSTER_CITIZENS).all(func(id: String) -> bool: return with_row.has(id))
	var controls := {
		"wrong name_key": {"name_key": "NPC_SOMETHING_ELSE"}, "voice out of range": {"voice": {"pitch": 9.0, "rate": 1.0}}, "unknown area": {"home_area": "atlantis"},
		"a generated floor is no home": {"home_area": "moerkeskoven_f3"}, "no dialogue": {"dialogue": ""}, "bad facing": {"facing": "UP"}, "bad schedule": {"schedule": "dance"},
		"visual == fallback outside the pack": {"visual": "zz_art", "fallback": "zz_art"}, "chain never reaches the pack": {"visual": "zz_art", "fallback": "zz_missing"},
		"a shop that is nobody's": {"shop_id": "no_such_shop_anywhere"}, "bad age": {"age": "ancient"}, "friendship not a bool": {"friendship": "yes"},
		"a shop of another keeper": {"shop_id": "seed_shop"},
	}
	var still_caught := true
	var missed: Array[String] = []
	for label in controls:
		var bad: Dictionary = row.duplicate(true)
		for k in controls[label]:
			bad[k] = controls[label][k]
		if _row_problems("zz_data_only_florist", bad, wider, all_visuals).is_empty():
			still_caught = false
			missed.append(label)
	t.check("roster_accepts_data_only_citizen", with_word.is_empty() and not without_word.is_empty() and required_still and still_caught,
		"a data-only row (new id, new role 'florist') is valid once npc_vocab names the role and invalid without it %s; the required ids still hold with it in the table; %d broken variants are all refused (not caught: %s)" % [str(without_word), controls.size(), str(missed)])


