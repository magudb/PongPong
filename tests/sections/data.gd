func _passthrough() -> void:
	var t = _t
	var shop: Dictionary = _lr.get_shop("fixture_furniture")
	var ok := not shop.is_empty()
	var problems: Array[String] = []
	if ok:
		var tabs: Array = shop["tabs"]
		var rotation: Array = shop["rotation"]
		var curve: Dictionary = shop["price_curve"]
		var checks := {
			"buy_multiplier": shop["buy_multiplier"] == 1.0 and typeof(shop["buy_multiplier"]) == TYPE_FLOAT,
			"sell_multiplier": shop["sell_multiplier"] == 0.5,
			"buys": shop["buys"] == ["furniture", "clothing"],
			"open_weekdays": shop["open_weekdays"] == [5, 6] and typeof(shop["open_weekdays"][0]) == TYPE_INT,
