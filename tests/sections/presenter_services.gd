extends RefCounted
const SECTION := "presenter_services"
const TIMEOUT_S := 90.0
func run(t) -> void:
	await t.start_world()
	var gm: Node = t.autoload("GameManager")
	var saves: Node = t.autoload("SaveManager")
	var quests: Node = t.autoload("QuestManager")
	var bus: Node = t.autoload("EventBus")
	saves.autosave_enabled = false
	gm.set_config_override("time.minutes_per_real_second", 0.0)
	var body: Node2D = t.world()._make_player()
	t.world()._register_player(body, 1, 2)
	t.world().add_child(body)
	var owner := Node.new()
	t.world().add_child(owner)
	var ui: Node = t.tree.get_first_node_in_group("dialogue_ui")
	var rows: Array = PlayerRegistry.for_player(&"p1", func(): return LifeFlow.offers("board"))
	t.check("eligible_physical_p1", not rows.is_empty())
	var row: Dictionary = rows[0]
	var id := StringName(str(row.quest_id))
	PlayerRegistry.for_player(&"p1", func(): quests.accept_quest(id))
	var starts: Array = []
	var observe := func(_n, _m): starts.append(true)
	bus.dialogue_started.connect(observe)
	var refused: RefCounted = PlayerRegistry.for_player(&"p0", func(): return LifeFlow.offer_request(owner, row, body))
	t.check("unavailable_explicit_p1_refused_before_presentation", refused == null and starts.is_empty() and not ui.is_open())
	if ui.is_open(): ui.close()
	bus.dialogue_started.disconnect(observe)
	var travel := Rejsestolpe2D.new()
	travel.stop = "farm"
	travel.area = t.world().area
	t.world().add_child(travel)
	travel.set_process(false)
	gm.set_flag(&"ft_traetoppen", 1)
	var notifications: Array = []
	var route := func(a, s): notifications.append([a,s,PlayerRegistry._acting_id])
	# Prevent real transition; the exact public notification remains observed.
	bus.area_change_requested.disconnect(t.world()._on_area_change_requested)
	bus.area_change_requested.connect(route)
	var end_owners: Array = []
	var ended := func(): end_owners.append(PlayerRegistry._acting_id)
	bus.dialogue_ended.connect(ended)
	PlayerRegistry.for_player(&"p0", func(): travel.interact(body))
	await t.page_to_choices(ui)
	ui._pick({"action":"travel", "spawn":"from_farm"})
	await t.frames(2)
	t.check("travel_exact_physical_owner", end_owners == [&"p1"] and notifications.size() == 1 and notifications[0][2] == &"p1", str([end_owners,notifications]))
	bus.dialogue_ended.disconnect(ended)
	notifications.clear()
	travel.interact(body)
	await t.page_to_choices(ui)
	var replaced := func(): PlayerRegistry.reset_states()
	bus.dialogue_ended.connect(replaced, CONNECT_ONE_SHOT)
	ui._pick({"action":"travel", "spawn":"from_farm"})
	await t.frames(2)
	t.check("travel_no_suffix_after_profile_replacement", notifications.is_empty())
	bus.area_change_requested.disconnect(route)
	bus.area_change_requested.connect(t.world()._on_area_change_requested)
	var board := NoticeBoard2D.new()
	t.world().add_child(board)
	var roster := PlayerRegistry._states.keys()
	board.interact(body)
	t.check("board_missing_profile_refuses_without_creation", PlayerRegistry._states.keys() == roster and not ui.is_open())
	if ui.is_open(): ui.close()
	board.free()
	travel.free()
	owner.free()
	t.world()._unregister_player(body)
	gm.clear_config_overrides()
