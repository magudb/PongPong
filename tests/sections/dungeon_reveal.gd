extends RefCounted
const SECTION := "dungeon_reveal"
const TIMEOUT_S := 180.0
const Reveal := preload("res://scripts/ui/dungeon/loot_reveal.gd")
const Cues := preload("res://scripts/dungeon_run/cues.gd")
class AudioProbe extends Node:
	var calls := []
	func play_sfx(id: String) -> void: calls.append(["sfx",id])
	func play_music(id: String,fade: float) -> void: calls.append(["music",id,fade])
func run(t) -> void:
	await _run(t,false)
func run_windowed(t) -> void:
	await _run(t,true)
func _enemy(area: IsoArea, offset: Vector2, kind := "ugleoje") -> Enemy2D:
	var node: Enemy2D = Enemy2D.create_marker({"kind":kind},offset,area.global_to_cell(offset),area)
	area.objects.add_child(node)
	node.set_awake(true)
	node.set_physics_process(false)
	return node
func _run(t,native: bool) -> void:
	await t.start_world()
	var world: WorldRoot2D = t.world()
	var eco: Node = t.autoload("EconomyManager")
	var loot: Node = t.autoload("LootService")
	var gm: Node = t.autoload("GameManager")
	var reveal: CanvasLayer = t.tree.get_first_node_in_group("loot_reveal")
	t.check("tier_selection_by_rank",Reveal.tier_for(&"normal") == 0 and Reveal.tier_for(&"uncommon") == 0 and Reveal.tier_for(&"rare") == 1 and Reveal.tier_for(&"unique") == 2 and Reveal.tier_for(&"legendary") == 3)
	DungeonRun.apply_preset("none")
	eco.remove_item(&"etagekort",eco.count_item(&"etagekort"))
	DungeonFloors.inst().enter(1)
	await t.until(func(): return world.area.map.id == &"moerkeskoven_f1" and not world.traveling,10.0)
	for node in t.tree.get_nodes_in_group("enemy"): node.queue_free()
	await t.frames(2)
	world.player.invulnerable = true
	var own_before_signal := []
	var observed := func(id,_rarity): own_before_signal.append(eco.count_item(id) > 0)
	EventBus.rare_item_found.connect(observed)
	loot.deliver(&"gem_owl_eye",1)
	await t.frames(2)
	t.check("item_already_in_store_before_reveal",own_before_signal == [true] and reveal.tier == 2 and reveal.active.id == &"gem_owl_eye" and eco.count_item(&"gem_owl_eye") == 1)
	t.check("unique_card_before_skip_threshold",not reveal.can_skip() and reveal._root.is_visible_in_tree())
	if native:
		await t.seconds(.4)
		await t.capture("unique_card")
	await t.seconds(.85)
	t.check("unique_card_skippable",reveal.can_skip())
	var skip := InputEventAction.new()
	skip.action = &"interact"
	skip.pressed = true
	reveal._input(skip)
	t.check("skip_keeps_owned_item",reveal.active.is_empty() and not reveal._root.visible and eco.count_item(&"gem_owl_eye") == 1)
	loot.deliver(&"gem_owl_eye",1)
	await t.frames(2)
	t.check("no_reveal_for_duplicate_keepsake",reveal.active.is_empty() and own_before_signal.size() == 1)
	EventBus.rare_item_found.disconnect(observed)
	var area := world.area
	var at := world.player.global_position
	var near := _enemy(area,at+Vector2(250,0))
	var far := _enemy(area,at+Vector2(1000,0))
	var asleep := _enemy(area,at+Vector2(350,0))
	asleep.set_awake(false)
	var boss := _enemy(area,at+Vector2(350,0),"snurresvamp")
	t.check("awe_probe_uses_real_boss_flag",boss is DungeonBoss2D and boss.is_boss and not boss.is_in_group("boss"))
	var music := AudioServer.get_bus_index("Music")
	var gain_before := AudioServer.get_bus_volume_db(music)
	loot.deliver(&"gem_rune_heart",1)
	await t.frames(2)
	t.check("legendary_awe_stun",reveal.tier == 3 and near.state == Enemy2D.S.STUN and near.remaining > 2.8 and far.state != Enemy2D.S.STUN and asleep.state != Enemy2D.S.STUN and boss.state != Enemy2D.S.STUN)
	t.check("music_duck_is_temporary",is_equal_approx(AudioServer.get_bus_volume_db(music),gain_before-6))
	if native:
		await t.seconds(.5)
		await t.capture("legendary_moment")
	await t.seconds(1.05)
	reveal._input(skip)
	t.check("legendary_skip_releases_only_awe",reveal.active.is_empty() and near.remaining == 0 and is_equal_approx(AudioServer.get_bus_volume_db(music),gain_before))
	reveal.enqueue(&"gem_owl_eye",&"unique")
	reveal.enqueue(&"gem_rune_heart",&"legendary")
	await t.frames(2)
	t.check("queue_best_rank_first",reveal.active.id == &"gem_rune_heart" and reveal.pending.is_empty())
	near.stun(5)
	reveal.finish()
	t.check("skip_preserves_a_later_combat_stun",near.state == Enemy2D.S.STUN and near.remaining == 5)
	DungeonRun.set_assist("assist_reduce_flash",true)
	reveal.enqueue(&"gem_rune_heart",&"legendary")
	await t.frames(2)
	t.check("reduce_flash_variant",reveal.reduced and reveal.duration == 2 and reveal._dim.color.a == 0 and (reveal._tween == null or not reveal._tween.is_running()))
	var particles := []
	_collect_particles(reveal._root,particles)
	t.check("reduce_flash_has_no_particles",particles.is_empty() and reveal._card.scale == Vector2.ONE)
	reveal.finish()
	DungeonRun.apply_preset("none")
	for enemy in [near,far,asleep,boss]: enemy.queue_free()
	await world.travel(&"farm",&"default")
	# Appraisal results deliberately render above the modal even with the forest
	# HUD hidden. The automatic rare signal is suppressed to avoid two reveals.
	gm.push_modal(&"appraisal",true)
	EventBus.rare_item_found.emit(&"gem_owl_eye",&"unique")
	await t.frames(2)
	t.check("appraisal_automatic_reveal_suppressed",reveal.active.is_empty())
	Reveal.appraisal_results([{"gem":"gem_owl_eye","rarity":"unique"}])
	await t.frames(2)
	t.check("appraisal_reveal_above_hidden_forest_hud",reveal.tier == 2 and reveal._root.is_visible_in_tree() and not world.game_ui.get_screen(&"forest_hud").visible)
	if native:
		await t.seconds(.4)
		await t.capture("appraisal_reveal_in_town")
	reveal.finish()
	gm.pop_modal(&"appraisal")
	var audio := AudioProbe.new()
	Svc.override("AudioManager",audio)
	Cues.play(Cues.rarity_cue(&"normal"))
	Cues.play(Cues.rarity_cue(&"rare"))
	Cues.play(Cues.rarity_cue(&"unique"))
	Cues.play(Cues.rarity_cue(&"legendary"))
	Cues.play("music/dungeon_act2")
	t.check("cues_by_rarity_and_directory",audio.calls == [["sfx","pickup_soft"],["sfx","loot_rare"],["sfx","loot_unique"],["sfx","loot_legendary"],["music","dungeon_act2",1.0]])
	Svc.clear_overrides()
	audio.free()
	# DUN-02: only the boss floors (4, 8, 12) score a boss fight; the rest play their act.
	t.check("floor_music_by_act_and_boss",Cues.floor_music(1) == "music/dungeon_act1" and Cues.floor_music(3) == "music/dungeon_act1" and Cues.floor_music(4) == "music/boss" and Cues.floor_music(5) == "music/dungeon_act2" and Cues.floor_music(8) == "music/boss" and Cues.floor_music(11) == "music/dungeon_act4" and Cues.floor_music(12) == "music/boss_final")
	Cues.play("sfx/zz_missing_cue")
	Cues.play("music/zz_missing_track")
	t.check("missing_audio_is_silent",true)
	var parent: Node = reveal.get_parent()
	reveal.enqueue(&"iron_sword",&"rare")
	parent.remove_child(reveal)
	await t.frames(2)
	t.check("detached_reveal_cancels_deferred_delivery",reveal.pending.is_empty() and reveal.active.is_empty() and not reveal._root.visible)
	EventBus.rare_item_found.emit(&"iron_sword",&"rare")
	t.check("detached_reveal_ignores_late_signal",reveal.pending.is_empty())
	parent.add_child(reveal)
func _collect_particles(node: Node, out: Array) -> void:
	if node is CPUParticles2D: out.append(node)
	for child in node.get_children(): _collect_particles(child,out)
