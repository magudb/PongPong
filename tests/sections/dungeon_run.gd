extends RefCounted
const SECTION := "dungeon_run"
const TIMEOUT_S := 180.0
func run(t) -> void:
	await _run(t,false)
func run_windowed(t) -> void:
	await _run(t,true)
func _run(t, native: bool) -> void:
	await t.start_world()
	var gm: Node = t.autoload("GameManager")
	var eco: Node = t.autoload("EconomyManager")
	var world: WorldRoot2D = t.world()
	var curve := [5,6,8,10,12,13,15,16,18,20,22,24]
	for index in 12:
		t.check("curve_%d" % (index+1),DungeonRun.expected_weapon(index+1) == curve[index])
		for row in [["bat",6],["ugleoje",16],["tornebusk",24]]:
			t.check("hp_%s_floor_%d" % [row[0],index+1],DungeonRun.enemy_hp(row[0],index+1) == roundi(float(row[1])*curve[index]/10.0))
	t.check("curve_clamps_and_deepens",DungeonRun.expected_weapon(-1) == 5 and DungeonRun.expected_weapon(15) == 30)
	t.check("starter_and_iron_ratings",is_equal_approx(DungeonRun.weapon_rating("sword_rusty"),5) and is_equal_approx(DungeonRun.weapon_rating("iron_sword"),12))
	t.check("weapon_ranges_match_ttk",DungeonRun.weapon_range("sword_rusty") == Vector2i(1,1) and DungeonRun.weapon_range("iron_sword") == Vector2i(1,6))
	for family in ["sword","club","spear","dagger","staff"]:
		var row := DungeonRun.weapon_family(family)
		var dps := float(row.damage_x1000)/1000.0/(float(row.time)+float(row.cooldown))
		t.check("family_%s_dps_parity" % family,absf(dps/2.5-1.0) <= 0.101)
	var luck := Perks.total("luck")
	for preset in ["none","light","cozy"]:
		DungeonRun.apply_preset(preset)
		var level := ["none","light","cozy"].find(preset)
		t.check("preset_%s_hearts" % preset,DungeonRun.assist_hearts() == level*2 and DungeonRun.hearts_max() == 10+level*2)
		t.check("preset_%s_windup" % preset,is_equal_approx(DungeonRun.windup_mult(),1+level*.2))
		t.check("preset_%s_dodge_is_milliseconds" % preset,is_equal_approx(DungeonRun.dodge_bonus(),level*.05))
		for kind in ["bat","ugleoje","tornebusk"]:
			for tier in range(1,5):
				var base: Array = [1,1,1,2] if kind == "bat" else [1,2,2,2]
				t.check("damage_%s_%s_%d" % [preset,kind,tier],DungeonRun.enemy_damage(kind,tier) == (1 if level == 2 else maxi(1,int(base[tier-1])-level)))
		t.check("preset_%s_does_not_change_loot_luck" % preset,is_equal_approx(Perks.total("luck"),luck))
	DungeonRun.apply_preset("none")
	t.check("oil_paused",DungeonRun.oil_step(50,10,{"paused":true,"on_floor":true}) == 50)
	t.check("oil_hub",DungeonRun.oil_step(50,10,{"paused":false,"on_floor":false}) == 50)
	t.check("oil_standard",DungeonRun.oil_step(50,10,{"on_floor":true}) == 40)
	t.check("oil_light",DungeonRun.oil_step(50,10,{"on_floor":true,"assist_oil":1}) == 45)
	t.check("oil_cozy",DungeonRun.oil_step(50,10,{"on_floor":true,"assist_oil":2}) == 50)
	t.check("oil_race_and_gem_multiply_once",DungeonRun.oil_step(50,10,{"on_floor":true,"race_mult":.5,"gem_mult":.8}) == 46)
	t.check("light_never_below_35_percent",DungeonRun.light_ratio(0) == .35 and DungeonRun.light_ratio(150) == 1)
	for hearts in range(1,21):
		t.check("darkness_floor_%d" % hearts,DungeonRun.bite_due(0,hearts,12) == (hearts > 2))
	t.check("darkness_interval_and_oil",not DungeonRun.bite_due(1,5,13) and not DungeonRun.bite_due(0,5,11))
	t.check("auto_refuel_prioritizes_oil",DungeonRun.auto_refuel_item(15,{"lantern_oil":1,"lysdraabe":1}) == &"lantern_oil")
	t.check("auto_refuel_fallback_and_threshold",DungeonRun.auto_refuel_item(15,{"lysdraabe":1}) == &"lysdraabe" and DungeonRun.auto_refuel_item(16,{"lantern_oil":1}) == &"")
	var snapshots: Array = []
	var listener := func(_key,_value): snapshots.append(gm.world_flags.duplicate())
	EventBus.flag_changed.connect(listener)
	var result := DungeonRun.boss_killed("snurresvamp",4)
	EventBus.flag_changed.disconnect(listener)
	t.check("boss_first_kill_adds_one_heart",result.first and DungeonRun.hearts_bonus() == 2)
	t.check("boss_flags_are_atomic_for_save_observers",not snapshots.is_empty() and snapshots.all(func(s): return s.get(&"dungeon_hearts_bonus") == 2 and int(s.get(&"dungeon_boss_snurresvamp",0)) > 0))
	t.check("boss_repeat_never_duplicates_hearts",not DungeonRun.boss_killed("snurresvamp",4).first and DungeonRun.hearts_bonus() == 2)
	DungeonRun.boss_killed("snurresvamp_gloed",8)
	DungeonRun.boss_killed("snurresvamp_konge",12)
	t.check("three_bosses_cap_at_six_half_hearts",DungeonRun.hearts_bonus() == 6 and DungeonRun.hearts_max() == 16)
	var flags: Dictionary = gm.world_flags.duplicate()
	t.check("flag_batch_refuses_invalid_input_atomically",not gm.set_flags({"dungeon_hearts_bonus":0,"bad":Vector2.ONE}) and gm.world_flags == flags)
	DungeonRun.apply_preset("cozy")
	t.check("hearts_composition_includes_assist",DungeonRun.hearts_max() == 20)
	DungeonRun.set_assist("assist_dodge",1)
	t.check("custom_setting_keeps_other_assists",DungeonRun.assist("assist_preset") == "custom" and DungeonRun.assist_hearts() == 4 and DungeonRun.dodge_bonus() == .05)
	var settings: TTScreen = world.game_ui.get_screen(&"settings_ui")
	gm.push_modal(&"pause",true)
	settings.open()
	await t.frames(2)
	t.check("forest_help_available_from_settings",settings.forest_help_button.visible)
	settings.forest_help_button.pressed.emit()
	await t.frames(3)
	var help: TTScreen = settings.get_node_or_null("ForestHelp")
	t.check("all_eleven_assists_exposed_in_game",help != null and help.is_open() and help.value_buttons.size() == 11)
	if native: await t.capture("forest_help")
	help.preset_buttons["light"].pressed.emit()
	t.check("help_presets_change_real_owner",DungeonRun.assist("assist_preset") == "light" and DungeonRun.hearts_max() == 18)
	help.close()
	settings.close()
	gm.pop_all_modals()
	DungeonRun.apply_preset("none")
	var watch: DungeonRunWatch = DungeonRun.attach(world.game_ui)
	t.check("run_watch_attach_is_idempotent",DungeonRun.attach(world.game_ui) == watch and DungeonRun.attach(world.game_ui.get_screen(&"forest_hud")) == watch and watch.get_parent() == world)
	world.player.oil = 50
	world.player.half_hearts = 3
	var gold: int = eco.gold
	var surprise_origin := EventBus.interaction_origin()
	EventBus.publish_dungeon_surprise(EventBus.dungeon_surprise_receipt(surprise_origin),{"id":"firefly_swarm","oil_s":30})
	EventBus.publish_dungeon_surprise(EventBus.dungeon_surprise_receipt(surprise_origin),{"id":"acorn_purse","gold":25})
	EventBus.publish_dungeon_surprise(EventBus.dungeon_surprise_receipt(surprise_origin),{"id":"cocoa_thermos","heal_half_hearts":2})
	t.check("run_watch_applies_surprises",world.player.oil == 80 and world.player.half_hearts == 5 and eco.gold == gold+25,str([world.player.oil,world.player.half_hearts,eco.gold-gold,t.tree.get_nodes_in_group("player").size()]))
	var picker: Array = DungeonRun.picker_lines(12)
	t.check("picker_warns_for_highlighted_floor",picker[0].warn and not DungeonRun.picker_lines(1)[0].warn and picker[4].text.contains("10"))
	eco.add_item(&"etagekort",2,true)
	var floors := DungeonFloors.inst()
	floors.enter(3)
	await t.until(func(): return world.area.map.id == &"moerkeskoven_f3" and not world.traveling,10.0)
	t.check("map_reveals_first_visited_floor_and_consumes_one",floors.is_revealed(3) and eco.count_item(&"etagekort") == 1)
	var old_tut: Variant = gm.get_flag(&"dungeon_tut","")
	gm.set_flag(&"dungeon_tut","")
	gm.set_config_override("dungeon_run.tutorial.spacing",20)
	t.check("tutorial_first_hint_emits",DungeonRun.tutorial_say("hub"))
	t.check("tutorial_spacing_and_flags",not DungeonRun.tutorial_say("abilities") and not DungeonRun.tutorial_say("hub"))
	DungeonRun.set_assist("assist_hints",0)
	gm.set_config_override("dungeon_run.tutorial.spacing",0)
	t.check("tutorial_disabled",not DungeonRun.tutorial_say("eyes"))
	gm.set_flag(&"dungeon_tut",old_tut)
	gm.clear_config_overrides()
	DungeonRun.apply_preset("none")
	floors.leave()
	await t.until(func(): return world.area.map.id == &"moerkeskoven" and not world.traveling,10.0)
	t.check("hub_does_not_drain_player_oil",not world.player.oil_draining and DungeonRun.oil_step(50,10,{"on_floor":false}) == 50)
