; Godot 4.7 standalone isometric-2D character demo.
config_version=5

[application]
config/name="PongPong Isometric 2D"
config/description="12 animated chibi characters, isometric 2D demo."
run/main_scene="res://scenes/isometric/demo_isometric_2d.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

