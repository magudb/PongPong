# Godot
# .godot/ is the engine cache. *.import and *.uid files are COMMITTED (import presets live in
# them and a fresh clone needs them), so they are deliberately NOT ignored.
.godot/
# Translations load at runtime from the CSVs (LocalizationManager); the csv importer would
# otherwise commit ~28 junk binaries (plan R.4). Every CSV ships a keep-import instead.
*.translation
!legacy/**/*.translation
export.cfg
.godot-bin/

# Feature tooling (addendum 4.4 / RV-P11)
# flock file of tools/features/add_autoload.py (exception E1, repo root)
project.godot.lock
# validator stage tree and reports
tools/features/_stage/
tools/features/reports/

# Art tooling (plan R.8)
tools/art/.venv/
tools/art/.venv
# bake output and staging, hidden from the importer by tools/art/.gdignore
tools/art/_stage/
__pycache__/

# Dungeon tooling output (stress, simulation, bake) - design addendum, lead patch
tools/dungeon/_stage/
tools/dungeon_run/_stage/
tools/dungeon_loot/_stage/

# Other tools' state and scratch
.mimocode/
.playwright-mcp/
/scratch/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Builds
build/
dist/
*.pck
*.exe
*.x86_64
*.app
*.dmg
*.apk
*.aab

# Lua hot-reload temp
*.lua.tmp

# Saves (user://)
saves/
