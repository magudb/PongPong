# Godot
# .godot/ is the engine cache. *.import and *.uid files are COMMITTED (import presets live in
# them and a fresh clone needs them), so they are deliberately NOT ignored.
.godot/
# Translations load at runtime from the CSVs (LocalizationManager); the csv importer would
# otherwise commit ~28 junk binaries (plan R.4). Every CSV ships a keep-import instead.
*.translation
!legacy/**/*.translation
export.cfg
.godot-bin/

# Godot 3 import cache and C#/Mono leftovers (this is a GDScript project; never wanted in git)
/.import/
.mono/
mono_crash.*.json

# Feature tooling (addendum 4.4 / RV-P11)
# flock file of tools/features/add_autoload.py (exception E1, repo root)
project.godot.lock
# validator stage tree and reports
tools/features/_stage/
tools/features/reports/

# Art tooling (plan R.8)
tools/art/.venv/
tools/art/.venv
# bake output and staging, hidden from the importer by tools/art/.gdignore
tools/art/_stage/
__pycache__/

# Dungeon tooling output (stress, simulation, bake) - design addendum, lead patch
tools/dungeon/_stage/
tools/dungeon_run/_stage/
tools/dungeon_loot/_stage/

# Other tools' state and scratch
.mimocode/
.playwright-mcp/
/scratch/
# scratch folder of tools/dev/selftest_harness.sh (removed again by its cleanup)
.selftest/

# Python (tools/loc, tools/copy, tools/voice, tools/art) - venvs anywhere, caches, packaging
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Local environment and secrets
.env
.env.*
!.env.example

# Coverage and loose logs at the repo root (QA evidence logs under docs/ ARE committed)
.coverage
htmlcov/
/coverage/
/logs/

# Editor/merge leftovers
*.tmp
*.orig
*.rej
*~

# OS
.DS_Store
Thumbs.db
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.directory
.Trash-*

# IDE
.vscode/
.idea/
*.swp
*.swo
.vs/
.fleet/
*.sublime-workspace

# Builds
build/
dist/
*.pck
*.exe
*.x86_64
*.app
*.dmg
*.apk
*.aab
*.pdb
*.dSYM/

# Lua hot-reload temp
*.lua.tmp

# Saves (user://)
saves/
