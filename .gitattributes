# Normalise line endings: text files are LF in the repo and in the working tree (Godot reads both).
* text=auto eol=lf

# Binary assets: never diffed, merged or line-ending converted.
*.webp binary
*.png binary
*.ogg binary
*.ttf binary
*.jpg binary
*.jpeg binary
*.glb binary
*.mp3 binary
*.wav binary
*.otf binary

# Git LFS for the art is OPEN FOR THE USER TO DECIDE (the repo only has a baseline commit; PLAN
# addendum DF19 expects about 110 MB of art and recommends LFS). To switch it on, run
# `git lfs install` once, uncomment the line(s) below BEFORE the first art commit, then commit.
# Nothing here is active: without these lines the files are stored as plain git blobs.
#assets/**/*.webp filter=lfs diff=lfs merge=lfs -text
#assets/**/*.png filter=lfs diff=lfs merge=lfs -text
#assets/**/*.ogg filter=lfs diff=lfs merge=lfs -text
